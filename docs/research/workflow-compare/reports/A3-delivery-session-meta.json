{
  "group": "A3-delivery-session-meta",
  "components": [
    {
      "id": "pb-opening-a-pr",
      "kind": "playbook",
      "name": "Opening a PR",
      "label": "开设PR",
      "family": "交付",
      "purpose": "把已完成工作整理成可审查、可落地的 PR。",
      "trigger": "其他 playbook 结束时调用。",
      "steps": [
        {
          "text": "在 main 派生 worktree，整理有序且可独立落地的提交",
          "actor": "main",
          "uses": [],
          "human_gate": false
        },
        {
          "text": "运行 deslop、no-comments；按技术写作规则写标题正文",
          "actor": "main",
          "uses": [
            "sk-no-comments",
            "sk-technical-writing",
            "sk-unslop"
          ],
          "human_gate": false
        },
        {
          "text": "选定 Origin 或 gh，创建 ready PR；误成 draft 就转 ready",
          "actor": "main",
          "uses": [
            "ar-pr",
            "pf-github"
          ],
          "human_gate": false
        },
        {
          "text": "较大工作建 base-branch stack；子 PR 指向父分支",
          "actor": "main",
          "uses": [
            "ar-stack"
          ],
          "human_gate": false
        },
        {
          "text": "发布 URL 后继续完成 phase 或 stack；不自动 babysit",
          "actor": "main",
          "uses": [
            "pb-babysit"
          ],
          "human_gate": false
        }
      ],
      "outputs": [
        "ready PR URL",
        "有序提交",
        "必要时的 PR stack"
      ],
      "done_when": "PR 已 ready，URL 已交回；未开始 babysit。",
      "on_fail": "脏分支移到新 worktree；纠结的 worktree 从 main 重做；Origin 不可用改 gh。",
      "human": "PR 合并不在此授权。",
      "parallel": "子 agent 可开 PR，但只返 URL，不 babysit。",
      "principles": [],
      "source": "docs/research/code-landing-refs/pstack/skills/poteto-mode/playbooks/opening-a-pr.md # Opening a PR"
    },
    {
      "id": "pb-babysit",
      "kind": "playbook",
      "name": "Babysit",
      "label": "守候PR",
      "family": "交付",
      "purpose": "按 merge frontier 清除审查和检查阻碍，停在 merge-ready。",
      "trigger": "用户在 phase 或整组 stack 建好后要求 babysit、get it green、merge-ready、评论处理或状态检查。",
      "steps": [
        {
          "text": "声明模式并选 forge",
          "actor": "main",
          "uses": [
            "ar-stack",
            "pf-github"
          ],
          "human_gate": false
        },
        {
          "text": "只处理最低未合并 PR；确认单一 babysitter",
          "actor": "main",
          "uses": [
            "ar-pr",
            "ar-stack"
          ],
          "human_gate": false
        },
        {
          "text": "先查冲突，再查评论和 CI；冲突交 owner rebase",
          "actor": "main",
          "uses": [
            "pf-github"
          ],
          "human_gate": false
        },
        {
          "text": "GitHub 用 watch-pr；Origin 用原生命令",
          "actor": "main",
          "uses": [
            "sc-watch-pr",
            "pf-github"
          ],
          "human_gate": false
        },
        {
          "text": "drive/background 用动态 loop，push 后重启 watch",
          "actor": "main",
          "uses": [
            "pf-loop"
          ],
          "human_gate": false
        },
        {
          "text": "Bugbot 逐条核查；真问题先证伪再修，噪声解释",
          "actor": "main",
          "uses": [
            "pf-bugbot",
            "ar-pr"
          ],
          "human_gate": false
        },
        {
          "text": "到 merge-ready 报告；合并交 Shipping",
          "actor": "main",
          "uses": [
            "pb-shipping",
            "hu-merge-auth"
          ],
          "human_gate": true
        }
      ],
      "outputs": [
        "merge-ready frontier",
        "已修复或驳回的评论记录",
        "阻碍和需人决定的事项"
      ],
      "done_when": "GitHub 单/stack 的 READY、queued 的 WAITING/merge-queue 或 COMPLETE；Origin 无 blocker 且 checks green。",
      "on_fail": "冲突停下报告需 rebase；CI flake/基础设施只重建一次；状态查询失败依 watcher verdict 报告。",
      "human": "owner approval 不是待修 blocker；无明确 merge/land/ship 请求不合并。",
      "parallel": "每 stack 一个 babysitter；其余 subagent 未规定；drive/background 用动态 /loop。",
      "principles": [],
      "source": "docs/research/code-landing-refs/pstack/skills/poteto-mode/playbooks/babysit.md # Babysit"
    },
    {
      "id": "pb-shipping",
      "kind": "playbook",
      "name": "Shipping",
      "label": "合并交付",
      "family": "交付",
      "purpose": "独立验证后仅把从 stack 根部连续合格的 PR 逐一合并。",
      "trigger": "用户明确要求 land、ship、merge 或 merge when ready。",
      "steps": [
        {
          "text": "选 forge；每 PR 由非作者 cloud agent 独立验证",
          "actor": "main",
          "uses": [
            "pf-cursor-cloud",
            "ar-pr"
          ],
          "human_gate": false
        },
        {
          "text": "从底部算连续 PASS/PASS+NOTES 区间",
          "actor": "main",
          "uses": [
            "ar-stack"
          ],
          "human_gate": false
        },
        {
          "text": "记录 SHA 与 patch-id；变动则重验",
          "actor": "main",
          "uses": [
            "ar-pr"
          ],
          "human_gate": false
        },
        {
          "text": "只更新 bottom PR 到 trunk；重查状态",
          "actor": "main",
          "uses": [
            "pf-github"
          ],
          "human_gate": false
        },
        {
          "text": "只合并或自动合并 bottom；确认 merged 再动 child",
          "actor": "main",
          "uses": [
            "hu-merge-auth",
            "pf-github"
          ],
          "human_gate": true
        },
        {
          "text": "每次合并重算 frontier；watch 仅作唤醒",
          "actor": "main",
          "uses": [
            "sc-watch-pr",
            "pf-loop"
          ],
          "human_gate": false
        },
        {
          "text": "到首个未验证 PR 停止并报告 ceiling",
          "actor": "main",
          "uses": [
            "ar-stack"
          ],
          "human_gate": false
        }
      ],
      "outputs": [
        "逐个合并的 PR",
        "verified run 与 ceiling 报告"
      ],
      "done_when": "连续 verified run 已合并，或在首个未验证 PR 处停止。",
      "on_fail": "任何 FAIL 或过期 patch verdict 中断链；队列停滞先诊断，不盲改；仅指定 CLOSED/CI/mergeStateStatus 视为硬失败。",
      "human": "明确合并指令才执行 merge；扩展 verified run 另需新验证轮次。",
      "parallel": "每 PR 一个 Cursor cloud agent，且不能是该 PR 作者；不批量。",
      "principles": [],
      "source": "docs/research/code-landing-refs/pstack/skills/poteto-mode/playbooks/shipping.md # Shipping"
    },
