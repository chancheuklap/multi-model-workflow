{
  "group": "A5-thinking-skills",
  "components": [
    {
      "id": "sk-how",
      "kind": "skill",
      "name": "how",
      "label": "运行机制说明",
      "family": "理解",
      "purpose": "解释代码结构、运行流程与归属，形成可工作的系统理解。",
      "trigger": "询问 how X works、代码 walkthrough 或模块归属/分层。",
      "steps": [
        {
          "text": "Step 1 按单模块/跨文件复杂度分流；不明时走简单路线。",
          "actor": "main",
          "uses": [],
          "human_gate": false
        },
        {
          "text": "Step 2a 复杂问题分成 2–4 个独立切面，同时派只读 explorer。",
          "actor": "main",
          "uses": [
            "ag-general-purpose"
          ],
          "human_gate": false
        },
        {
          "text": "Step 2b 简单问题派一名只读 explainer，直接调查并解释。",
          "actor": "main",
          "uses": [
            "ag-general-purpose"
          ],
          "human_gate": false
        },
        {
          "text": "Step 3 全部返回后派只读 explainer 合成并核对矛盾。",
          "actor": "main",
          "uses": [
            "ag-general-purpose"
          ],
          "human_gate": false
        },
        {
          "text": "Step 4 原样或轻度编辑呈交解释。",
          "actor": "main",
          "uses": [],
          "human_gate": false
        }
      ],
      "outputs": [
        "Overview、Key Concepts、How It Works、Where Things Live、Gotchas（按需）"
      ],
      "done_when": "explainer 交回统一解释并呈给用户。",
      "on_fail": "explorer 未查明的连接明确列为 Open Questions；矛盾由 explainer 查代码。",
      "human": "范围含糊时说明理解并允许用户纠正；不设强制等待。",
      "parallel": "简单：1 explainer，claude-opus-5-5-max，只读；复杂：2–4 explorers，grok-4.7-xhigh-fast，只读，全部返回后 1 explainer，claude-opus-5-5-max，只读。",
      "principles": [],
      "source": "docs/research/code-landing-refs/pstack/skills/how/SKILL.md # How"
    },
    {
      "id": "sk-why",
      "kind": "skill",
      "name": "why",
      "label": "设计缘由调查",
      "family": "理解",
      "purpose": "并行搜集历史证据，区分确证、推断与未知，解释代码为何这样设计。",
      "trigger": "询问设计缘由、取舍、回归、事故或数据阈值。",
      "steps": [
        {
          "text": "Step 1 确定代码目标和问题；模糊时声明解释后继续。",
          "actor": "main",
          "uses": [],
          "human_gate": false
        },
        {
          "text": "Step 2 用代码位置、git blame/history 和 PR 建立锚点。",
          "actor": "main",
          "uses": [
            "pf-github"
          ],
          "human_gate": false
        },
        {
          "text": "Step 3 发现 MCP，按可用证据类别各派一名 investigator；缺席要记录。",
          "actor": "main",
          "uses": [
            "ag-general-purpose"
          ],
          "human_gate": false
        },
        {
          "text": "防御性代码另给各来源 investigator 事故调查指引。",
          "actor": "main",
          "uses": [],
          "human_gate": false
        },
        {
          "text": "Step 4 等调查完，派一名 synthesizer 核对引文并按信心层级合成。",
          "actor": "main",
          "uses": [
            "ag-general-purpose"
          ],
          "human_gate": false
        },
        {
          "text": "Step 5 呈交；改代码前给 Preserve/Change/Avoid/Risk。",
          "actor": "main",
          "uses": [],
          "human_gate": false
        }
      ],
      "outputs": [
        "带引用的原因报告、Sources Consulted、Confidence Summary；改动前约束集"
      ],
      "done_when": "七类来源搜索或明确跳过，合成结果保留证据等级与空缺。",
      "on_fail": "MCP 不可用或确实无关时注明；证据冲突并列；不能查明时写 Unknown。",
      "human": "目标含糊时允许纠正；没有必等人的门禁。",
      "parallel": "最多 7 名 investigator（每个可用类别 1 名，source control 必有），grok-4.7-xhigh-fast，readonly=false 但不得写；完成后 1 synthesizer，claude-opus-5-5-max，readonly=false 以便用 MCP 核引文。",
      "principles": [],
      "source": "docs/research/code-landing-refs/pstack/skills/why/SKILL.md # Why"
    },
    {
      "id": "sk-recall",
      "kind": "skill",
      "name": "recall",
      "label": "恢复工作脉络",
      "family": "理解",
      "purpose": "从近期聊天、共享记录与实时状态重建当前工作。",
      "trigger": "开始/恢复工作前的 recall、catch me up、where did I leave off。",
      "steps": [
        {
          "text": "先分类：单次会话转 session-pickup；完整状态 capsule 直接采用。",
          "actor": "main",
          "uses": [
            "pb-session-pickup"
          ],
          "human_gate": false
        },
        {
          "text": "锁定时间、主题与工作区，默认近 7 天及当前工作区。",
          "actor": "main",
          "uses": [],
          "human_gate": false
        },
        {
          "text": "较多聊天按语料切片派快模型并行检索；1–2 次聊天自己查。",
          "actor": "main",
          "uses": [
            "ag-general-purpose",
            "pf-transcripts"
          ],
          "human_gate": false
        },
        {
          "text": "具名功能/文件/故障时与聊天检索并行调用 why 来源调查。",
          "actor": "main",
          "uses": [
            "sk-why"
          ],
          "human_gate": false
        },
        {
          "text": "用 git、gh 核对 PR/分支/票据，必要时读完整 transcript。",
          "actor": "main",
          "uses": [
            "pf-github",
            "pf-transcripts"
          ],
          "human_gate": false
        },
        {
          "text": "按固定结构写简报，并经 unslop。",
          "actor": "main",
          "uses": [
            "sk-unslop"
          ],
          "human_gate": false
        }
      ],
      "outputs": [
        "当前状态简报：最多五条 capsule、逐线程状态、问题与单一下一步"
      ],
      "done_when": "简报按主题交付且状态与实时记录核对。",
      "on_fail": "不可用来源标为缺口；不从单独 transcript 猜共享历史。",
      "human": "范围先声明，用户可纠正；无强制等待。",
      "parallel": "较多聊天：按语料切片并行 subagents，数量未指定，快而便宜模型 slug 未指定；why 的来源调查并行。1–2 聊天不派。读写模式未指定。",
      "principles": [],
      "source": "docs/research/code-landing-refs/pstack/skills/recall/SKILL.md # Recall"
    },
    {
      "id": "sk-teach",
      "kind": "skill",
      "name": "teach",
      "label": "解释并教学",
      "family": "理解",
      "purpose": "合并 how 与 why 的调查，用适合提问者的深度讲清机制和缘由。",
      "trigger": "teach me、help me understand、解释变更或子系统。",
      "steps": [
        {
          "text": "从问题和对话判断学习目标及已知内容，不额外盘问。",
          "actor": "main",
          "uses": [],
          "human_gate": false
        },
        {
          "text": "先读代码定位，再按问题大小并行调用 how 与 why；小变更可只用一个。",
          "actor": "main",
          "uses": [
            "sk-how",
            "sk-why"
          ],
          "human_gate": false
        },
        {
          "text": "先给通俗定义，再按机制、原因和边界逐层讲解。",
          "actor": "main",
          "uses": [],
          "human_gate": false
        },
        {
          "text": "三部分以上的图逐张加一部分；需要时看 diff、代码或调试器。",
          "actor": "main",
          "uses": [],
          "human_gate": false
        },
        {
          "text": "经 unslop 收紧表述，保留 why 信心措辞；回答后让人决定是否深入。",
          "actor": "main",
          "uses": [
            "sk-unslop"
          ],
          "human_gate": false
        }
      ],
      "outputs": [
        "逐层、可继续追问的解释"
      ],
      "done_when": "给出最小完整答案，后续深度由人引导。",
      "on_fail": "why 证据不足时保留不确定性，不改写为确定结论。",
      "human": "讲完一层后等人决定是否追问；不是实现授权门禁。",
      "parallel": "how 与 why 可并行调用；本 skill 不自定 agent 数、模型或只读参数，继承二者；小变更可只调用一项。",
      "principles": [],
      "source": "docs/research/code-landing-refs/pstack/skills/teach/SKILL.md # Teach"
    },
    {
