    {
      "id": "sk-architect",
      "kind": "skill",
      "name": "architect",
      "label": "架构草图",
      "family": "设计",
      "purpose": "先用调用者视角和类型草图确定模块边界，再按草图实现，错误时重设计。",
      "trigger": "/architect、architect this、design this 或不宜直接写代码的非平凡工作。",
      "steps": [
        {
          "text": "Start 建五阶段 todolist。",
          "actor": "main",
          "uses": [],
          "human_gate": false
        },
        {
          "text": "Phase A 用 how 建立系统模型；重定归属/分层时再用 why；纯绿地可跳过。",
          "actor": "main",
          "uses": [
            "sk-how",
            "sk-why"
          ],
          "human_gate": false
        },
        {
          "text": "Phase B 用 arena 并行生成至少两种结构不同的设计，筛红旗并合成。",
          "actor": "main",
          "uses": [
            "sk-arena"
          ],
          "human_gate": false
        },
        {
          "text": "Phase C 默认继续；显式 checkpoint 才等签署；可做质询。",
          "actor": "main",
          "uses": [
            "sk-interrogate",
            "hu-checkpoint"
          ],
          "human_gate": true
        },
        {
          "text": "Phase D 按草图填代码，偏离时追查草图、需求或实现。",
          "actor": "main",
          "uses": [],
          "human_gate": false
        },
        {
          "text": "Phase E 若反复同形摩擦则废弃草图，重跑 how、重设计、删减并回 Phase B。",
          "actor": "main",
          "uses": [
            "sk-how",
            "sk-arena"
          ],
          "human_gate": false
        }
      ],
      "outputs": [
        "类型/签名草图、模块图（大改动）、一页 rationale，含 usage 与 synthesis decision"
      ],
      "done_when": "实现符合选中草图；若草图被证伪则重设计而非补丁。",
      "on_fail": "持续同形 workaround、逃逸类型或多次偏离时废弃并重跑 Phase A/B。",
      "human": "只有调用者明确要求 checkpoint 才在 Phase C 等 sign-off；质疑设计后重新 grounding。",
      "parallel": "Phase B 经 arena：默认 3 runners，各 claude-opus-5-5-max、gpt-5.6-sol-max、grok-4.7-xhigh-fast；候选各写独立位置，非只读；arena 另有 1 只读 cross-judge。",
      "principles": [
        "pr-exhaust-the-design-space",
        "pr-foundational-thinking",
        "pr-outcome-oriented-execution",
        "pr-redesign-from-first-principles",
        "pr-fix-root-causes",
        "pr-subtract-before-you-add",
        "pr-separate-before-serializing-shared-state",
        "pr-encode-lessons-in-structure",
        "pr-boundary-discipline",
        "pr-make-operations-idempotent",
        "pr-laziness-protocol",
        "pr-minimize-reader-load"
      ],
      "source": "docs/research/code-landing-refs/pstack/skills/architect/SKILL.md # Architect"
    },
