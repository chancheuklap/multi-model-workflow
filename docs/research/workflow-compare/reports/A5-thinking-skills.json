        {
          "text": "交付改写，不增加新结论。",
          "actor": "main",
          "uses": [],
          "human_gate": false
        }
      ],
      "outputs": [
        "上一条消息的通俗改写"
      ],
      "done_when": "交付改写。",
      "on_fail": "无指定失败处理。",
      "human": "无",
      "parallel": "无",
      "principles": [],
