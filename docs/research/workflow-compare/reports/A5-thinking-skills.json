    {
      "id": "sk-figure-it-out",
      "kind": "skill",
      "name": "figure-it-out",
      "label": "自设计工作流程",
      "family": "设计执行",
      "purpose": "无窄 playbook 可用时先设计可审计流程，再按假设、实测、记录执行。",
      "trigger": "/figure-it-out、大迁移、多部分工作或无人实时监督的长任务。",
      "steps": [
        {
          "text": "Start 建 todolist，首项读 poteto-mode Principles。",
          "actor": "main",
          "uses": [
            "sk-poteto-mode"
          ],
          "human_gate": false
        },
        {
          "text": "Phase A 定可证伪完成条件、量化范围和严谨度；长任务给人一次 checkpoint。",
          "actor": "main",
          "uses": [
            "hu-checkpoint"
          ],
          "human_gate": true
        },
        {
          "text": "Phase B 按风险拆可独立落地单元，先建验证基线；单向设计调用 architect。",
          "actor": "main",
          "uses": [
            "sk-architect"
          ],
          "human_gate": false
        },
        {
          "text": "只在明确边界并行；各 worker 独立分支/工作树；写下阶段清单。",
          "actor": "main",
          "uses": [
            "ag-general-purpose"
          ],
          "human_gate": false
        },
        {
          "text": "Phase C 每单元提出假设、最小改动、实物验证，进则留、退则撤；委派配 judge。",
          "actor": "main",
          "uses": [],
          "human_gate": false
        },
        {
          "text": "Phase D 每步落地时用 show-me-your-work 记录决策。",
          "actor": "main",
          "uses": [
            "sk-show-me-your-work"
          ],
          "human_gate": false
        },
        {
          "text": "Phase E 对真实产品整体验证，重复纠正固化为 gate/检查。",
          "actor": "main",
          "uses": [],
          "human_gate": false
        }
      ],
      "outputs": [
        "事先设计的 playbook、决策轨迹、验证结果与未决事项"
      ],
      "done_when": "整体真实产品满足 Phase A predicate；未验证项明确报告。",
      "on_fail": "无效改动回退；gate 被钻空子则重置并加固；INCONCLUSIVE 不算通过。",
      "human": "多小时工作有一次 checkpoint；可逆工作继续，单向决策须人决定。",
      "parallel": "仅跨独立边界派 worker，数量/模型/只读均未指定；每个 worker 独立工作树或分支，委派工作配 judge（数量/模型未指定）。",
      "principles": [
        "pr-prove-it-works",
        "pr-never-block-on-the-human",
        "pr-foundational-thinking",
        "pr-laziness-protocol",
        "pr-separate-before-serializing-shared-state",
        "pr-sequence-verifiable-units",
        "pr-encode-lessons-in-structure"
      ],
      "source": "docs/research/code-landing-refs/pstack/skills/figure-it-out/SKILL.md # Figure it out"
    },
    {
      "id": "sk-blast-radius",
      "kind": "skill",
      "name": "blast-radius",
      "label": "变更波及范围",
      "family": "风险核验",
      "purpose": "越过 diff 和符号搜索找隐藏破坏，并用真实代码证明关键安全前提。",
      "trigger": "blast radius of X、what could this break、对小 diff 不放心。",
      "steps": [
        {
          "text": "读 diff、变更符号；用 why Step 2 获取 PR 与提交。",
          "actor": "main",
          "uses": [
            "sk-why"
          ],
          "human_gate": false
        },
        {
          "text": "找安全依赖的 1–2 个关键事实，不先列大量猜测。",
          "actor": "main",
          "uses": [],
          "human_gate": false
        },
        {
          "text": "查库实现、固定版本、补丁、时序与跨语言/协议消费方。",
          "actor": "main",
          "uses": [],
          "human_gate": false
        },
        {
          "text": "把已证实风险与已排除项分开，注明概率、代价和出处。",
          "actor": "main",
          "uses": [],
          "human_gate": false
        },
        {
          "text": "写最小脚本/测试调用真实代码并运行，记录证明等级。",
          "actor": "main",
          "uses": [],
          "human_gate": false
        },
        {
          "text": "大或宽变更用 arena 同题多模型并行，再合并答案。",
          "actor": "main",
          "uses": [
            "sk-arena"
          ],
          "human_gate": false
        },
        {
          "text": "经 unslop 交付安全事实、风险、已排除项和合并前最低成本验证。",
          "actor": "main",
          "uses": [
            "sk-unslop"
          ],
          "human_gate": false
        }
      ],
      "outputs": [
        "波及范围报告、真实代码的证明结果、合并前验证建议"
      ],
      "done_when": "关键安全事实被证明或明确写 unproven，风险与 cleared 分列。",
      "on_fail": "未证明则标 unproven；不捏造调用方/API。",
      "human": "无",
      "parallel": "普通任务无并行；大/宽变更经 arena，默认 3 候选模型与 1 只读 cross-judge，具体由 arena 配置决定。",
      "principles": [],
      "source": "docs/research/code-landing-refs/pstack/skills/blast-radius/SKILL.md # Blast radius"
    }
