{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/_shared/**",
              "components/canvas/**",
              "components/detail/**",
              "components/settings/**",
              "components/status/**",
              "components/tasks/**",
              "components/topbar/**",
              "ui_kits/task-board/**",
              "ui_kits/task-board/data/**",
              "ui_kits/task-board/lib/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Geist|Geist Mono|Instrument Serif))/i]",
        "message": "Font not provided by the design system. Available: Geist, Geist Mono, Instrument Serif."
      },
      {
        "selector": "JSXOpeningElement[name.name='Brand'] > JSXAttribute > JSXIdentifier[name!=/^(?:repo|key|ref|className|style|children)$/]",
        "message": "<Brand> doesn't accept that prop. Declared props: repo."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:kind|disabled|onClick|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: kind, disabled, onClick, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='kind'] > Literal[value!=/^(?:primary|link)$/]",
        "message": "<Button> kind must be one of 'primary' | 'link'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CodeText'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|key|ref|className|style|children)$/]",
        "message": "<CodeText> doesn't accept that prop. Declared props: children."
      },
      {
        "selector": "JSXOpeningElement[name.name='ColumnEyebrow'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|count|key|ref|className|style|children)$/]",
        "message": "<ColumnEyebrow> doesn't accept that prop. Declared props: label, count."
      },
      {
        "selector": "JSXOpeningElement[name.name='ContainerCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:item|onPick|onToggle|key|ref|className|style|children)$/]",
        "message": "<ContainerCard> doesn't accept that prop. Declared props: item, onPick, onToggle."
      },
      {
        "selector": "JSXOpeningElement[name.name='Counter'] > JSXAttribute > JSXIdentifier[name!=/^(?:lamp|label|count|sub|button|hot|title|onClick|key|ref|className|style|children)$/]",
        "message": "<Counter> doesn't accept that prop. Declared props: lamp, label, count, sub, button, hot, title, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='Counter'] > JSXAttribute[name.name='lamp'] > Literal[value!=/^(?:orange|green|ink|hollow)$/]",
        "message": "<Counter> lamp must be one of 'orange' | 'green' | 'ink' | 'hollow'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DecisionCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:item|onPick|key|ref|className|style|children)$/]",
        "message": "<DecisionCard> doesn't accept that prop. Declared props: item, onPick."
      },
      {
