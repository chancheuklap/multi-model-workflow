{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "bash \"$HOME/.cursor/hooks/session-triage.sh\""
      }
    ],
    "preCompact": [
      {
        "command": "bash \"$HOME/.cursor/hooks/session-triage.sh\""
      }
    ],
    "beforeShellExecution": [
      {
        "command": "bash \"$HOME/.cursor/hooks/guard-redline.sh\"",
        "failClosed": true
      }
    ],
    "afterShellExecution": [
      {
        "command": "bash \"$HOME/.cursor/hooks/record-step.sh\""
      }
    ]
  }
}
