{
  "mcpServers": {
    "serena": {
      "type": "stdio",
      "command": "serena",
      "args": [
        "start-mcp-server",
        "--context", "agent",
        "--project-from-cwd",
        "--enable-web-dashboard", "false",
        "--open-web-dashboard", "false",
        "--enable-gui-log-window", "false"
      ],
      "enabledTools": [
        "find_symbol",
        "find_referencing_symbols",
        "get_symbols_overview",
        "find_implementations"
      ]
    },
    "graphify": {
      "type": "stdio",
      "command": "graphify-mcp"
    }
  }
}
