{
  "schema_version": "1",
  "product": "desktop-core",
  "build_target": {
    "desktop_dir": "desktop",
    "runtime_lane": "core_exe",
    "entry_module": "backend_core",
    "installer_brand": "Core Desktop",
    "deps_extra": null,
    "asset_roots": [],
    "native_ext_dll": [],
    "nuitka_include": [],
    "nuitka_nofollow": []
  },
  "stages": [
    {"name": "verify_key", "run": ["verify-key"]}
  ],
  "diagnose": ["diagnose-release"],
  "derive": ["derive-release"],
  "editable_paths": ["src/**"],
  "protection_source": "release-protection.json",
  "build_hooks": {
    "runtime_prepare": ["prepare-runtime"],
    "artifact_scan": ["scan-artifact"],
    "package_integrity": ["check-package"],
    "asset_parity": null,
    "credential_proof": null
  },
  "post_fix_gate": ["post-fix-gate"],
  "fix_executor": ["fix-release"],
  "event_sink": ["write-event"]
}
