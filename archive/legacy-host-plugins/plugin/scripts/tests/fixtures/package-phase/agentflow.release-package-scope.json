{
  "schema_version": "1",
  "all_products_paths": [
    "src/shared/**",
    "scripts/release/**",
    "scripts/agentflow-build",
    "pyproject.toml",
    "uv.lock",
    "assets/brand/**"
  ],
  "ignored_paths": ["docs/**", "tests/**", "src/gateway/**", "src/collection/**", "migrations/**", "deploy/**", ".github/**"],
  "products": [
    {"product": "duck", "manifest": "fixtures/adapters/duck.release-adapter.json", "paths": ["desktop/**", "src/local_agent/**", "src/dashboard/**"]},
    {"product": "parrot", "manifest": "fixtures/adapters/parrot.release-adapter.json", "paths": ["desktop-parrot/**", "src/parrot_dubbing/**"]},
    {"product": "hedgehog", "manifest": "fixtures/adapters/hedgehog.release-adapter.json", "paths": ["desktop-hedgehog/**", "src/hedgehog/**"]}
  ]
}
