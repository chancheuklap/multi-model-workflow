{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/session-triage.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/guard-redline.sh\"",
            "timeout": 5,
            "if": "Bash(*push*)"
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/guard-redline.sh\"",
            "timeout": 5,
            "if": "Bash(*pr merge*)"
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/guard-redline.sh\"",
            "timeout": 5,
            "if": "Bash(*/merge*)"
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/guard-redline.sh\"",
            "timeout": 5,
            "if": "Bash(*deploy*)"
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/guard-redline.sh\"",
            "timeout": 5,
            "if": "Bash(*apply*)"
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/guard-redline.sh\"",
            "timeout": 5,
            "if": "Bash(*destroy*)"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/record-step.sh\"",
            "timeout": 10,
            "if": "Bash(git commit:*)"
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/record-step.sh\"",
            "timeout": 10,
            "if": "Bash(git -C*)"
          }
        ]
      }
    ]
  }
}
