#!/usr/bin/env python3
"""This repository's one check: the syntax of the changed files, the shared checks and the
test suites, in three tiers.

    scripts/check            the default tier: syntax of the files changed against the base, then
                             each suite whose inputs in MAP hold a changed path
    scripts/check --all      every step runnable on this machine
    scripts/check --staged   the syntax of the staged files; no commit-hook tool is configured here

The base is MMW_BASE_REF when it is set, else origin/dev, this repository's base branch.
Changed paths are `git diff --name-only <base>...HEAD`, the uncommitted changes and the
untracked files. Only the --all e2e step installs its nested package dependencies. The repository
has no root package manager. Suites that run under `uv run` resolve their own dependencies,
and the browser suites fetch the
Chromium build their Playwright needs (mmw-v4/tests/lib/ensure_chromium.py).

Before the steps run, one `SELECT <suite>: <changed path> (<input>)` line per selected suite.
Each step prints `PASS|FAIL|ENV <step> <seconds>s`; a failing step adds its last lines and the
path of its full log under .scratch/check/, and so does a step that exits 2 (ENV: its suite
cannot run on this machine, such as Chromium that will not start). The last line is the summary.

Exit 0: every step passed. Exit 1: a step is red, or the self-check found a test directory MAP
does not name and EXCLUDED does not list. Exit 2: the environment cannot run the check: a tool
missing from PATH or a base ref git does not know, and nothing was run; or no step is red and a
non-e2e suite exited 2 because it cannot run here. E2e steps treat every nonzero exit
as a failure, including runner configuration and test collection errors.

Python standard library only.
"""

from __future__ import annotations

import os
import shutil
import subprocess
import sys
import time
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
DEFAULT_BASE = "origin/dev"
TAIL = 20

SHARED = (
    "python3 mmw-v4/tests/lib/check_module_paths.py"
    " && python3 mmw-v4/tests/lib/check_wiring.py"
    " && python3 mmw-v4/tests/lib/check_host_neutrality.py"
    " && uv run -q mmw-v4/tests/lib/check_skill_frontmatter.py"
)

# step: (command, tools it needs on PATH)
STEPS = {
    "shared-checks": (SHARED, ["python3", "uv"]),
    "lib": ("bash mmw-v4/tests/lib/run.sh", ["bash", "python3"]),
    "check-interfaces": ("python3 mmw-v4/skills/dispatch/scripts/check-interfaces.py", ["python3"]),
    "e2e-task-board": (
        "npm ci --prefix tests/e2e/task-board --silent"
        " && npm exec --prefix tests/e2e/task-board -- e2e run"
        " --config tests/e2e/task-board/e2e.config.ts --target product",
        ["npm", "node", "python3", "gh"],
    ),
    "board": ("bash mmw-v4/tests/board/run.sh", ["bash", "python3", "uv", "node"]),
    "diagram-design": ("bash mmw-v4/tests/diagram-design/run.sh", ["bash", "python3", "uv"]),
    "dispatch": ("bash mmw-v4/tests/dispatch/run.sh", ["bash", "python3", "uv", "git", "node"]),
    "exe-release": ("bash mmw-v4/tests/exe-release/run.sh", ["bash", "python3", "uv"]),
    "install": ("bash mmw-v4/tests/install/run.sh", ["bash", "python3", "uv"]),
    "liveness": ("bash mmw-v4/tests/liveness/run.sh", ["bash", "python3", "uv"]),
    "session-start": ("bash mmw-v4/tests/session-start/run.sh", ["bash", "python3", "uv"]),
    "relay": ("bash mmw-v4/tests/relay/run.sh", ["bash", "python3", "uv"]),
    "setup-mmw": ("bash mmw-v4/tests/setup-mmw/run.sh", ["bash", "python3", "uv", "git"]),
    "retro": ("bash mmw-v4/tests/retro/run.sh", ["bash", "python3", "uv", "git"]),
    "register-problem": ("bash mmw-v4/tests/register-problem/run.sh", ["bash", "python3", "uv", "git"]),
    "verify-ticket": ("bash mmw-v4/tests/verify-ticket/run.sh", ["bash", "python3", "uv", "node"]),
    "writing-for-agents": ("bash mmw-v4/tests/writing-for-agents/run.sh", ["bash", "python3", "uv", "git"]),
    "worktree-audit": ("bash mmw-v4/tests/worktree-audit/run.sh", ["bash", "python3", "uv", "git", "jq"]),
}

# Each suite's inputs: a changed path starting with the prefix selects the suites, and a suite
# no changed path selects does not run.
DISPATCH = "mmw-v4/skills/dispatch/"
VERIFY = "mmw-v4/skills/verify-ticket/"
MAP = [
    # The shared checks read every module path, skill wiring and frontmatter under mmw-v4/.
    ("mmw-v4/", ["shared-checks"]),
    ("mmw-v4/skills/", ["check-interfaces"]),
    (DISPATCH, ["dispatch"]),
    (DISPATCH + "scripts/relay.py", ["relay"]),
    (DISPATCH + "scripts/briefs.py", ["relay"]),
    (DISPATCH + "scripts/runners/", ["relay", "liveness", "install"]),
    (DISPATCH + "scripts/statedir.py", ["relay", "liveness", "board"]),
    (DISPATCH + "scripts/turn-guard.py", ["liveness", "install"]),
    (DISPATCH + "scripts/watchdog.py", ["liveness"]),
    (DISPATCH + "scripts/tool-guard.py", ["install"]),
    (DISPATCH + "scripts/ghlist.py", ["board", "relay"]),
    (DISPATCH + "scripts/tracker.py", ["setup-mmw", "register-problem", "retro"]),
    (DISPATCH + "scripts/models.py", ["board", "relay"]),
    (DISPATCH + "roles.json", ["board", "relay"]),
    (VERIFY, ["verify-ticket"]),
    # test_dispatch.sh runs verify-ticket's scripts through --tools.
    (VERIFY + "scripts/", ["dispatch"]),
    (VERIFY + "scripts/events.py", ["board", "relay", "register-problem", "retro"]),
    (VERIFY + "scripts/issue_tree.py", ["board", "relay"]),
    (VERIFY + "scripts/verify-ticket.py", ["setup-mmw"]),
    ("mmw-v4/skills/retro/", ["retro"]),
    ("mmw-v4/skills/register-problem/", ["register-problem", "retro"]),
    ("mmw-v4/skills/setup-mmw/", ["setup-mmw"]),
    ("mmw-v4/skills/diagram-design/", ["diagram-design"]),
    ("mmw-v4/skills/exe-release/", ["exe-release"]),
    ("mmw-v4/skills/writing-for-agents/scripts/", ["writing-for-agents"]),
    ("mmw-v4/skills/mmw-mode/scripts/session-start.py", ["session-start", "install"]),
    ("mmw-v4/skills/mmw-mode/scripts/worktree-audit.sh", ["worktree-audit"]),
    ("mmw-v4/board/", ["board"]),
    ("mmw-v4/install.sh", ["install"]),
    ("mmw-v3/install.sh", ["install"]),
    ("mmw-v4/prompt/", ["install"]),
    *[(f"mmw-v4/tests/{name}/", [name]) for name in STEPS if (ROOT / "mmw-v4/tests" / name).is_dir()],
]

# Test roots: every directory directly under each must be a suite above or listed here.
TEST_ROOTS = ["mmw-v4/tests"]
# Trees whose test directories are history or third-party snapshots, never run.
NOT_OURS = ("mmw-v2/", "mmw-v3/", "archive/", "deprecated/", "docs/research/", "upstream/", "mmw-v4/docs/retired-")
EXCLUDED = {
    "efforts/code-landing/prototypes/fixture/tests": "a prototype's fixture repository, test data rather than a suite",
    "tests": "the e2e tests under tests/e2e/<product>/ run only in the --all e2e-<product> steps, not by changed paths",
}
NOT_RUN_HERE = ("exe-release's PowerShell checks (mmw-v4/tests/exe-release/check-generated-powershell.sh,"
                " check-template-behaviour.sh): they need a Windows build machine")


def git(*args: str) -> subprocess.CompletedProcess:
    return subprocess.run(["git", *args], cwd=ROOT, capture_output=True, text=True)


def changed_paths(base: str) -> list[str]:
    committed = git("diff", "--name-only", f"{base}...HEAD")
    if committed.returncode != 0:
        raise EnvironmentError(f"git cannot diff against {base}: {(committed.stderr.strip().splitlines() or [''])[0]}; "
                               "set MMW_BASE_REF to a ref this clone has, or run `git fetch origin`")
    paths = set(committed.stdout.split())
    paths |= set(git("diff", "--name-only", "HEAD").stdout.split())
    paths |= set(git("ls-files", "--others", "--exclude-standard").stdout.split())
    return sorted(paths)


def staged_paths() -> list[str]:
    return sorted(git("diff", "--cached", "--name-only", "--diff-filter=ACMR").stdout.split())


def selected(paths: list[str]) -> dict[str, tuple[str, str]]:
    """Each suite a changed path selects, with the first such path and the input that matched."""
    picked: dict[str, tuple[str, str]] = {}
    for path in paths:
        for prefix, names in MAP:
            if path.startswith(prefix):
                for name in names:
                    picked.setdefault(name, (path, prefix))
    return {name: picked[name] for name in STEPS if name in picked}


def self_check() -> list[str]:
    found = []
    for root in TEST_ROOTS:
        for child in sorted((ROOT / root).iterdir()):
            if child.is_dir() and child.name != "__pycache__" and not child.name.startswith("."):
                rel = f"{root}/{child.name}"
                if root == "mmw-v4/tests" and child.name in STEPS:
                    continue
                if rel not in EXCLUDED:
                    found.append(f"{rel} is a test directory STEPS and MAP in scripts/check do not name; "
                                 "add its suite there, or list it in EXCLUDED with the reason")
    roots = set()
    for path in git("ls-files").stdout.splitlines():
        if path.startswith(NOT_OURS) or path.startswith('"') or not (ROOT / path).is_file():
            continue
        parts = path.split("/")
        for i, part in enumerate(parts[:-1]):
            if part in ("tests", "test", "__tests__"):
                roots.add("/".join(parts[:i + 1]))
                break
    for root in sorted(roots):
        if root not in TEST_ROOTS and root not in EXCLUDED:
            found.append(f"{root} holds tests that scripts/check does not know; "
                         "add it to TEST_ROOTS with its suites, or list it in EXCLUDED with the reason")
    return found


def syntax_errors(paths: list[str]) -> list[str]:
    errors = []
    for rel in paths:
        path = ROOT / rel
        if not path.is_file() or rel.startswith("docs/research/"):
            continue
        if rel.endswith(".py"):
            try:
                compile(path.read_bytes(), rel, "exec")
            except (SyntaxError, ValueError) as err:
                errors.append(f"{rel}: {err}")
        elif rel.endswith(".sh") or (path.read_bytes()[:64].startswith(b"#!/usr/bin/env bash")):
            r = subprocess.run(["bash", "-n", str(path)], capture_output=True, text=True)
            if r.returncode != 0:
                errors.append(r.stderr.strip())
    return errors


class Run:
    def __init__(self) -> None:
        self.logs = ROOT / ".scratch" / "check" / time.strftime("%Y%m%d-%H%M%S")
        self.failed: list[str] = []
        self.unrunnable: list[str] = []
        self.count = 0

    def report(self, name: str, ok: bool, seconds: float, lines: list[str], log: Path | None,
               unrunnable: bool = False) -> None:
        self.count += 1
        print(f"{'PASS' if ok else 'ENV' if unrunnable else 'FAIL'} {name} {seconds:.0f}s", flush=True)
        if not ok:
            (self.unrunnable if unrunnable else self.failed).append(name)
            for line in lines[-TAIL:]:
                print(f"    {line}")
            if log:
                print(f"    full log: {log}")

    def step(self, name: str) -> None:
        command = STEPS[name][0]
        self.logs.mkdir(parents=True, exist_ok=True)
        log = self.logs / f"{name}.log"
        start = time.monotonic()
        with log.open("w") as out:
            rc = subprocess.run(["bash", "-c", command], cwd=ROOT, stdout=out, stderr=subprocess.STDOUT).returncode
        lines = log.read_text(errors="replace").splitlines()
        self.report(name, rc == 0, time.monotonic() - start, lines, log, unrunnable=rc == 2 and not name.startswith("e2e-"))

    def syntax(self, paths: list[str]) -> None:
        start = time.monotonic()
        errors = syntax_errors(paths)
        self.report(f"syntax ({len(paths)} files)", not errors, time.monotonic() - start, errors, None)


def missing_tools(names: list[str]) -> list[str]:
    needed = {tool for name in names for tool in STEPS[name][1]} | {"git"}
    return sorted(tool for tool in needed if shutil.which(tool) is None)


def cannot_run(reason: str) -> int:
    print(f"CHECK CANNOT RUN: {reason}")
    return 2


def main(argv: list[str]) -> int:
    tier = {"--staged": "staged", "--all": "all"}.get(argv[0], None) if argv else "default"
    if tier is None or len(argv) != (1 if argv else 0):
        print("usage: scripts/check [--staged | --all]", file=sys.stderr)
        return 2
    started = time.monotonic()
    run = Run()

    if tier == "staged":
        if shutil.which("git") is None:
            return cannot_run("git is not on PATH")
        print("no commit-hook tool is configured in this repository; checking the syntax of the staged files")
        run.syntax(staged_paths())
    else:
        if tier == "all":
            names = list(STEPS)
            paths = git("ls-files", "mmw-v4", "scripts").stdout.split()
            print("tier --all: every step")
        else:
            base = os.environ.get("MMW_BASE_REF") or DEFAULT_BASE
            if shutil.which("git") is None:
                return cannot_run("git is not on PATH")
            try:
                paths = changed_paths(base)
            except EnvironmentError as err:
                return cannot_run(str(err))
            chosen = selected(paths)
            names = list(chosen)
            print(f"tier default, base {base}: {len(paths)} changed paths; "
                  f"steps {', '.join(names) or 'none: no suite reads a changed path'}")
            for name, (path, prefix) in chosen.items():
                print(f"SELECT {name}: {path} ({prefix})")
        missing = missing_tools(names)
        if missing:
            return cannot_run(f"{', '.join(missing)} not on PATH, needed by "
                              + ", ".join(n for n in names if set(STEPS[n][1]) & set(missing))
                              + "; install it, or run from a shell whose PATH has it")
        problems = self_check()
        run.report("self-check", not problems, 0, problems, None)
        run.syntax(paths)
        for name in names:
            run.step(name)
        print(f"not run here: {NOT_RUN_HERE}")

    total = time.monotonic() - started
    if run.failed:
        unrunnable = f"; cannot run here: {', '.join(run.unrunnable)}" if run.unrunnable else ""
        print(f"CHECK FAIL {tier}: {len(run.failed)} of {run.count} steps red ({', '.join(run.failed)}){unrunnable} in {total:.0f}s")
        return 1
    if run.unrunnable:
        return cannot_run(f"{', '.join(run.unrunnable)} exited 2: these suites cannot run on this machine (above); "
                          f"the other {run.count - len(run.unrunnable)} steps passed in {total:.0f}s")
    print(f"CHECK PASS {tier}: {run.count} steps in {total:.0f}s")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
