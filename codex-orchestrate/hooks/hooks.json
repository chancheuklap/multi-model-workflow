{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${PLUGIN_ROOT}/hooks/session-start.sh\"",
            "timeout": 10,
            "statusMessage": "Loading Codex Orchestrate"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${PLUGIN_ROOT}/hooks/bash-pretool-dispatcher.sh\"",
            "timeout": 30,
            "statusMessage": "Checking Codex Orchestrate command gates"
          }
        ]
      },
      {
        "matcher": "apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${PLUGIN_ROOT}/hooks/edit-pretool-dispatcher.sh\"",
            "timeout": 30,
            "statusMessage": "Checking Codex Orchestrate edit gates"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${PLUGIN_ROOT}/hooks/bash-posttool-dispatcher.sh\"",
            "timeout": 30,
            "statusMessage": "Updating Codex Orchestrate state"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "pack_executor|complex_pack_executor|plan_writer|root_cause_analyst|code_explorer|complex_code_explorer|docs_worker",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${PLUGIN_ROOT}/hooks/subagent-start.sh\"",
            "timeout": 30,
            "statusMessage": "Injecting Codex Orchestrate subagent context"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "pack_executor|complex_pack_executor|plan_writer|root_cause_analyst|code_explorer|complex_code_explorer|docs_worker",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${PLUGIN_ROOT}/hooks/subagent-stop.sh\"",
            "timeout": 30,
            "statusMessage": "Collecting Codex Orchestrate subagent result"
          }
        ]
      }
    ]
  }
}
