{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "dispatch-envelope-v1",
  "type": "object",
  "required": ["protocol_version", "run_id", "phase", "agent_role", "repair_round", "idempotency_key"],
  "properties": {
    "protocol_version": { "type": "string", "const": "1" },
    "run_id": { "type": "string" },
    "phase": { "type": "string", "enum": ["plan-writing", "execution", "final-review", "discovery", "multi-pr-merge"] },
    "agent_role": { "type": "string" },
    "agent_id": { "type": ["string", "null"] },
    "pack_id": { "type": ["string", "null"] },
    "repair_round": { "type": "integer", "minimum": 0 },
    "idempotency_key": { "type": "string" },
    "disposition_refs": {
      "oneOf": [
        { "type": "array", "items": { "type": "string" } },
        { "type": "null" }
      ]
    },
    "review_intent": {
      "oneOf": [
        { "type": "string", "enum": ["baseline", "targeted-re-review", "path-a-re-review"] },
        { "type": "null" }
      ]
    },
    "exception_code": {
      "oneOf": [
        { "type": "string", "enum": ["3plus_files_control_flow", "user_requested", "rca_root_cause", "path_a_self_fix"] },
        { "type": "null" }
      ]
    },
    "correlation_id": {
      "type": ["string", "null"],
      "description": "{run_id}/{pack_id} — 跨 dispatch 追踪同一 pack 的 dispatch → return → review → repair 链路"
    }
  }
}
