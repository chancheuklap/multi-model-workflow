{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pack-return-v1.json",
  "title": "Codex Orchestrate Pack Return v1",
  "type": "object",
  "required": ["run_id", "pack_id", "verdict", "changed_files", "verification"],
  "properties": {
    "run_id": { "type": "string", "minLength": 1 },
    "pack_id": { "type": "string", "minLength": 1 },
    "agent_role": { "type": "string" },
    "agent_id": { "type": ["string", "null"] },
    "thread_id": { "type": ["string", "null"] },
    "worker_backend": { "type": ["string", "null"] },
    "worktree_path": { "type": ["string", "null"] },
    "branch": { "type": ["string", "null"] },
    "base_sha": { "type": ["string", "null"] },
    "head_sha": { "type": ["string", "null"] },
    "verdict": {
      "type": "string",
      "enum": ["pass", "needs_repair", "needs_context", "blocked", "unknown"]
    },
    "changed_files": {
      "type": "array",
      "items": { "type": "string" }
    },
    "verification": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["command", "status"],
        "properties": {
          "command": { "type": "string" },
          "status": { "type": "string", "enum": ["passed", "failed", "not_run"] },
          "evidence": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "open_items": {
      "type": "array",
      "items": { "type": "object", "additionalProperties": true }
    },
    "summary": { "type": "string" }
  },
  "additionalProperties": true
}
