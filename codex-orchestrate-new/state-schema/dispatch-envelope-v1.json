{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "dispatch-envelope-v1",
  "type": "object",
  "required": ["protocol_version", "run_id", "phase", "agent_role", "repair_round", "idempotency_key"],
  "properties": {
    "protocol_version": { "type": "string", "const": "1" },
    "run_id": { "type": "string" },
    "phase": { "type": "string", "enum": ["discovery", "plan-writing", "execution", "final-review", "bug-investigation", "direct-repair", "multi-pr-merge"] },
    "agent_role": { "type": "string" },
    "agent_id": { "type": ["string", "null"] },
    "pack_id": { "type": ["string", "null"] },
    "plan_id": {
      "type": ["string", "null"],
      "description": "Plan-level dispatch identifier (autonomous-mode plan worker). Semantics: during execution phase, exactly one of pack_id / plan_id is non-null. plan_id=<id> + pack_id=null = plan-level worker first dispatch (worker autonomously runs all packs in plan). Schema declaration only; hook parse logic ships in Plan 005."
    },
    "repair_round": { "type": "integer", "minimum": 0 },
    "idempotency_key": { "type": "string" },
    "disposition_refs": {
      "oneOf": [
        { "type": "array", "items": { "type": "string" } },
        { "type": "null" }
      ]
    },
    "review_intent": {
      "oneOf": [
        { "type": "string", "enum": ["baseline", "ad-hoc"] },
        { "type": "null" }
      ]
    },
    "exception_code": {
      "oneOf": [
        { "type": "string", "enum": ["3plus_files_control_flow", "user_requested", "rca_root_cause"] },
        { "type": "null" }
      ]
    },
    "correlation_id": {
      "type": ["string", "null"],
      "description": "{run_id}/{pack_id} — 跨 dispatch 追踪同一 pack 的 dispatch → return → review → repair 链路"
    },
    "worktree_path": { "type": ["string", "null"] },
    "plan_path": { "type": ["string", "null"] },
    "resume_from_pack_id": { "type": ["string", "null"] },
    "conflict_id": {
      "type": ["string", "null"],
      "description": "multi-pr-merge conflict id from merge-brief §4, used instead of disposition_refs for merge conflict repair rounds"
    }
  }
}
