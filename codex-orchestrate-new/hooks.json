{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${PLUGIN_ROOT}/hooks/session-start.sh\"",
            "statusMessage": "Load multi-model workflow",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${PLUGIN_ROOT}/scripts/guard-premature-push.sh\"",
            "statusMessage": "Check publish gates",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash \"${PLUGIN_ROOT}/hooks/enforce-plan-commit.sh\"",
            "statusMessage": "Check plan commit format",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash \"${PLUGIN_ROOT}/hooks/gate-codex-review.sh\"",
            "statusMessage": "Check review gate",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash \"${PLUGIN_ROOT}/hooks/enforce-repair-round-cap.sh\"",
            "statusMessage": "Check repair round cap",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${PLUGIN_ROOT}/hooks/guard-doc-edit.sh\"",
            "statusMessage": "Check worker document boundary",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${PLUGIN_ROOT}/hooks/track-review-budget.sh\"",
            "statusMessage": "Track review budget",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash \"${PLUGIN_ROOT}/hooks/track-execution-state.sh\"",
            "statusMessage": "Track execution state",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash \"${PLUGIN_ROOT}/scripts/cleanup-before-push.sh\"",
            "statusMessage": "Cleanup workflow state",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${PLUGIN_ROOT}/hooks/agent-return-handler.sh\"",
            "statusMessage": "Process worker return",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
