{
  "description": "Multi-model workflow lifecycle hooks for Codex.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${PLUGIN_ROOT}/hooks/session-triage.sh\"",
            "timeout": 10,
            "statusMessage": "恢复 MMW 任务状态"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${PLUGIN_ROOT}/hooks/guard-redline.sh\"",
            "timeout": 5,
            "statusMessage": "检查出站发布红线"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${PLUGIN_ROOT}/hooks/record-step.sh\"",
            "timeout": 10,
            "statusMessage": "记录 MMW Pack 提交"
          }
        ]
      }
    ]
  }
}
