#!/usr/bin/env bash
# mmw：多模型开发编排的机械层。
#
# 每条命令是（仓库，参数）的纯函数：不写状态文件，不记得上一步是什么。走到哪
# 一步由技能决定，这里永远不知道。
#
# 这里也不放 git push、不放远端合并、不放部署。宿主的命令白名单一旦放行
# `mmw`，CLI 内部起的 git 与 gh 子进程就不再经过宿主的权限层，那三件事必须留
# 在外面由人决定。

set -euo pipefail

MMW_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=lib/config.sh
. "$MMW_ROOT/cli/lib/config.sh"
# shellcheck source=lib/task.sh
. "$MMW_ROOT/cli/lib/task.sh"
# shellcheck source=lib/issue.sh
. "$MMW_ROOT/cli/lib/issue.sh"
# shellcheck source=lib/wiki.sh
. "$MMW_ROOT/cli/lib/wiki.sh"
# shellcheck source=lib/domain.sh
. "$MMW_ROOT/cli/lib/domain.sh"
# shellcheck source=lib/graph.sh
. "$MMW_ROOT/cli/lib/graph.sh"
# shellcheck source=lib/init.sh
. "$MMW_ROOT/cli/lib/init.sh"

# 用法分两层：这里只列命令名，参数在各命令自己的 usage_* 里。要查 dispatch
# 怎么写的人不该顺带读完 issue 的六个子命令——认不出参数时打的也是那一个命令
# 自己的用法，不是全部。
usage() {
  cat >&2 <<'EOF'
mmw <命令> [参数]

  dispatch    Claude Code：把 task 文件编成宿主工具参数（Pi 主路径不用）
  agents      把角色物化成宿主原生 subagent 文件
  skills      把技能源占位符物化成宿主写死的启动句
  skill-path  派出去那一侧读方法论的路径
  task        任务 worktree：查状态、建、绑分支、进、删
  result      后台结果：验证分支并集成到当前任务
  issue       tracker：建 issue、挂父子、算可认领集合
  wiki        Wiki：clone、重建导航、删本地文档前的验证
  domain      领域文档：初始化 Map、同步和检查消费合同、查询落点与 ADR 编号
  graph       结构图谱：状态、建一次、验证建对了
  mcp         MCP：按唯一服务器定义启动 Codex plugin 的 stdio 进程
  release     出包：起循环、问状态、跑一个阶段、派修、收束
  doctor      检查这台机器上跑 mmw 需要的东西（无参：跑一次就是检查）
  init        把当前仓库配置成能跑这套工作流的样子；幂等（无参：跑一次就是配置）

除 doctor 与 init 外，各命令不带参数运行时只显示该命令的用法。doctor 与 init 不收参数，
跑它们就是执行——查它们做什么看上面这两行，不要拿跑一次当查用法。
EOF
  return 2
}

usage_dispatch() {
  cat >&2 <<'EOF'
mmw dispatch <角色> --task <文件> [--cwd <目录>]

角色：
  worker            按一份 plan 写代码
  worker-high-risk  同上，但这块代码错了代价大
  prototype-worker  做一个指定的原型变体
  planner           按一张 ticket 写一份 plan
  investigator      查一个角度的事实，带出处交回
  designer          按一个约束提出 interface 方案
  reviewer-gpt      审查，GPT 那一侧
  reviewer-claude   审查，Claude 那一侧

参数：
  --task <文件>   task 四栏表文件，必填（与 Pi 的 task 同一概念）
  --cwd <目录>    角色的工作目录。会写文件的角色必填；只读角色省略时使用仓库根

模型、档位、护栏由角色决定，取自仓库根 .mmw.json，这里不用管。

返回开头一行是 mode: executed 或 mode: host-tool。
host-tool 时原样用返回中的 params 调工具（params 内已含 task 正文或等价字段）。
EOF
  return 2
}

usage_skill_path() {
  cat >&2 <<'EOF'
mmw skill-path <角色>

角色：worker、worker-high-risk、prototype-worker、planner、investigator、designer、reviewer-gpt、reviewer-claude

输出派出去那一侧读方法论的绝对路径，写进给它的提示词里。
宿主自己会把方法论送到位的角色什么都不输出，那时这句话省掉。
EOF
  return 2
}

usage_task() {
  cat >&2 <<'EOF'
mmw task new <slug> [原话] [--from <基点>]
    建 worktree 与分支，输出绝对路径。原话记进分支上的第一个空提交。
    不给 --from 就从当前 HEAD 分叉
mmw task enter <slug>       输出该 worktree 的绝对路径
mmw task cleanup <slug>     删 worktree 与分支；非强制，有未提交改动会失败
mmw task state              输出 outside、local、detached 或 bound
mmw task bind <完整分支名> <用户原话或任务目标> [--from <预期基点>]
                            把 detached linked worktree 绑到任务分支；给基点时先校验 HEAD

切进 worktree 只有宿主工具做得到，这条命令只输出路径。
EOF
  return 2
}

usage_result() {
  cat >&2 <<'EOF'
mmw result verify <结果分支> <HEAD SHA> <基点 SHA>
    验证分支、HEAD、基点和新提交，并返回结果 worktree 路径；不改 Git 状态
mmw result integrate <结果分支> <HEAD SHA> <基点 SHA>
    先验证，再用 git merge --no-ff 合入当前任务分支
EOF
  return 2
}

usage_issue() {
  cat >&2 <<'EOF'
mmw issue create --title <标题> --body-file <文件>
                 [--parent <n>] [--blocked-by <n,n>] [--label <a,b>]
    建 issue、挂父、连阻塞边、打标签，输出编号
mmw issue frontier <父编号> [--label <标签>]
    open、没被挡、没人认领的子 issue，编号升序。要全部的读全部行，
    要下一张的取第一行。每行两列，制表符分隔：编号、标题
mmw issue children <父编号>
    全部子 issue，编号升序，看任务走到哪一步。每行四列，制表符分隔：
    编号、标题、认领人（无人为空）、被几张还开着的 issue 挡着
mmw issue claim <编号>               认领；已被别人占住就失败
mmw issue link <子> --blocked-by <n> 单连一条阻塞边

--label 的取值由点名它的那个技能给，这里不列。
EOF
  return 2
}

usage_wiki() {
  cat >&2 <<'EOF'
mmw wiki ensure         clone 或 pull Wiki，输出本地路径
mmw wiki nav            从各页面重新生成 Home.md 与 _Sidebar.md
mmw wiki verify <slug>  删本地文档前那三条验证

推 Wiki 是对外发布，要用户点头，这里不做。
EOF
  return 2
}

usage_domain() {
  cat >&2 <<'EOF'
mmw domain path      领域文档形态与落点，第三列写着照它做什么
mmw domain map-init  独占创建多上下文 Map 的首次标准骨架
mmw domain sync      幂等同步领域上下文消费合同
mmw domain check     检查领域上下文消费合同
mmw domain adr-next  下一个 ADR 编号，四位零填充
mmw domain dirs      写入侧的四个配置落点：single、map、context、adr
EOF
  return 2
}

# 角色的产品语义：agent 名、方法论、是否可写。唯一事实来源是 agent-src/roles.json。
role_roster() {
  agents_role_field "$1" agent
}

role_skill() {
  agents_role_field "$1" skill
}

role_writable() {
  local w
  w="$(agents_role_field "$1" writable)" || return 1
  if [ "$w" = "true" ]; then
    echo yes
  else
    echo no
  fi
}

# 从 agent-src/roles.json 读角色字段。
agents_role_field() {
  local role="$1" field="$2"
  local path="$MMW_ROOT/agent-src/roles.json"
  [ -f "$path" ] || { echo "mmw: 找不到 $path" >&2; return 1; }
  jq -e --arg r "$role" '.roles | has($r)' "$path" >/dev/null 2>&1 || return 1
  case "$field" in
    agent)
      jq -er --arg r "$role" '.roles[$r].agent' "$path"
      ;;
    skill)
      jq -r --arg r "$role" '.roles[$r].skill // empty' "$path"
      ;;
    writable)
      jq -r --arg r "$role" 'if .roles[$r].writable then "true" else "false" end' "$path"
      ;;
    *)
      return 1
      ;;
  esac
}

cmd_dispatch() {
  local role="${1:-}"
  shift || true
  [ -n "$role" ] || usage_dispatch

  local roster skill
  roster="$(role_roster "$role")" || {
    echo "mmw: 认不出角色 $role" >&2
    usage_dispatch
  }
  skill="$(role_skill "$role")"

  local task="" cwd=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --task) task="${2:-}"; shift 2 ;;
      --cwd) cwd="${2:-}"; shift 2 ;;
      *) echo "mmw: 认不出参数 $1" >&2; usage_dispatch ;;
    esac
  done

  [ -n "$task" ] || { echo "mmw: dispatch 要 --task" >&2; usage_dispatch; }
  [ -f "$task" ] || { echo "mmw: task 文件不存在：$task" >&2; return 1; }
  task="$(cd "$(dirname "$task")" && pwd)/$(basename "$task")"

  local writable
  writable="$(role_writable "$role")"
  # 会写文件的角色必须显式指定工作目录：它要待在自己那棵 worktree 里，
  # 默认到仓库根就会写进主工作树。只读角色默认在仓库根，没有这个风险。
  if [ "$writable" = "yes" ] && [ -z "$cwd" ]; then
    echo "mmw: $role 会写文件，--cwd 必填，指向它该待的那棵 worktree" >&2
    return 1
  fi
  [ -n "$cwd" ] || cwd="$(mmw_repo_root)"
  [ -d "$cwd" ] || { echo "mmw: 工作目录不存在：$cwd" >&2; return 1; }
  cwd="$(cd "$cwd" && pwd)"

  local host adapter
  host="$(mmw_host)"
  adapter="$MMW_ROOT/cli/adapters/$host.sh"
  [ -f "$adapter" ] || { echo "mmw: 没有 $host 的 adapter" >&2; return 1; }

  export MMW_D_ROLE="$role"
  export MMW_D_ROSTER="$roster"
  export MMW_D_SKILL="$skill"
  export MMW_D_SKILL_PATH=""
  [ -z "$skill" ] || MMW_D_SKILL_PATH="$MMW_ROOT/skills/$skill/SKILL.md"
  export MMW_D_FAMILY MMW_D_MODEL_ID MMW_D_EFFORT
  MMW_D_FAMILY="$(mmw_model_field "$role" family)"
  MMW_D_MODEL_ID="$(mmw_model_field "$role" id)"
  MMW_D_EFFORT="$(mmw_model_field "$role" effort)"
  export MMW_D_TASK="$task"
  export MMW_D_CWD="$cwd"
  export MMW_D_WRITABLE="$writable"

  # 可写：必须是干净任务 worktree（与 agents guard 同一套）。
  if [ "$MMW_D_WRITABLE" = "yes" ]; then
    MMW_D_CWD="$(mmw_require_writable_cwd "$MMW_D_CWD")" || return 1
    export MMW_D_CWD
  fi

  # shellcheck source=/dev/null
  . "$adapter"
  mmw_adapter_dispatch
}

usage_agents() {
  cat >&2 <<'EOF'
mmw agents materialize --host <pi|cursor|all> [--check] [--config <文件>] [--out <目录>]
    把 agent-src 与型号表物化成宿主原生 subagent 文件
mmw agents resolve <角色>
    打印该角色的原生 agent 名、是否可写、skill（键: 值，一行一个）
mmw agents guard <角色> [--cwd <目录>]
    派前护栏：可写角色必须给干净 worktree；只读角色不需要 --cwd
mmw agents list
    列出全部角色与对应 agent 名

Pi / Cursor：主 agent 直调原生 subagent，不经 mmw dispatch。
先 resolve（或看 list）拿 agent 名，可写角色先 guard，再调宿主工具，
只传 agent、task 四栏全文、可写时的 cwd。
Claude Code：仍用 mmw dispatch。
EOF
  return 2
}

cmd_agents_resolve() {
  local role="${1:-}"
  [ -n "$role" ] || { echo "mmw: agents resolve 要角色名" >&2; usage_agents; }
  local agent skill writable
  agent="$(agents_role_field "$role" agent)" || {
    echo "mmw: 认不出角色 $role" >&2
    usage_agents
  }
  skill="$(agents_role_field "$role" skill)"
  writable="$(agents_role_field "$role" writable)"
  # json bool → yes/no，与 role_writable 口径一致
  if [ "$writable" = "true" ]; then
    writable="yes"
  else
    writable="no"
  fi
  printf 'role: %s\n' "$role"
  printf 'agent: %s\n' "$agent"
  printf 'writable: %s\n' "$writable"
  printf 'skill: %s\n' "$skill"
}

cmd_agents_list() {
  local path="$MMW_ROOT/agent-src/roles.json"
  [ -f "$path" ] || { echo "mmw: 找不到 $path" >&2; return 1; }
  jq -r '.roles | to_entries[] | "\(.key)\t\(.value.agent)\t\(if .value.writable then "writable" else "readonly" end)"' "$path"
}

cmd_agents_guard() {
  local role="" cwd=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --cwd) cwd="${2:-}"; shift 2 ;;
      --role)
        # 兼容 --role 写法
        role="${2:-}"; shift 2
        ;;
      -*)
        echo "mmw: 认不出参数 $1" >&2
        usage_agents
        ;;
      *)
        if [ -z "$role" ]; then
          role="$1"; shift
        else
          echo "mmw: 认不出参数 $1" >&2
          usage_agents
        fi
        ;;
    esac
  done
  [ -n "$role" ] || { echo "mmw: agents guard 要角色名" >&2; usage_agents; }

  local agent writable
  agent="$(agents_role_field "$role" agent)" || {
    echo "mmw: 认不出角色 $role" >&2
    usage_agents
  }
  writable="$(agents_role_field "$role" writable)"
  if [ "$writable" = "true" ]; then
    if [ -z "$cwd" ]; then
      echo "mmw: $role 会写文件，--cwd 必填，指向它该待的那棵 worktree" >&2
      return 1
    fi
    cwd="$(mmw_require_writable_cwd "$cwd")" || return 1
  fi
  printf 'ok: %s -> %s\n' "$role" "$agent"
}

cmd_agents() {
  local sub="${1:-}"
  shift || true
  case "$sub" in
    materialize)
      local host=""
      local -a args=()
      while [ $# -gt 0 ]; do
        case "$1" in
          --host) host="${2:-}"; shift 2 ;;
          --check) args+=(--check); shift ;;
          --config)
            [ -n "${2:-}" ] || { echo "mmw: --config 要路径" >&2; usage_agents; }
            args+=(--config "$2"); shift 2
            ;;
          --out)
            [ -n "${2:-}" ] || { echo "mmw: --out 要目录" >&2; usage_agents; }
            args+=(--out "$2"); shift 2
            ;;
          *) echo "mmw: 认不出参数 $1" >&2; usage_agents ;;
        esac
      done
      [ -n "$host" ] || { echo "mmw: agents materialize 要 --host" >&2; usage_agents; }
      args+=(--host "$host")
      python3 "$MMW_ROOT/cli/lib/materialize_agents.py" "${args[@]}"
      ;;
    resolve) cmd_agents_resolve "$@" ;;
    guard) cmd_agents_guard "$@" ;;
    list) cmd_agents_list ;;
    *) usage_agents ;;
  esac
}

usage_skills() {
  cat >&2 <<'EOF'
mmw skills materialize --host <pi|claude-code|codex|all> [--check] [--out <目录>]
    把 skills/ 源里的启动块与宿主动作块物化成宿主写死的操作
    pi → skills-pi/；claude-code → skills-claude-code/；codex → skills-codex/
EOF
  return 2
}

cmd_skills() {
  local sub="${1:-}"
  shift || true
  case "$sub" in
    materialize)
      local host=""
      local -a args=()
      while [ $# -gt 0 ]; do
        case "$1" in
          --host) host="${2:-}"; shift 2 ;;
          --check) args+=(--check); shift ;;
          --out)
            [ -n "${2:-}" ] || { echo "mmw: --out 要目录" >&2; usage_skills; }
            args+=(--out "$2"); shift 2
            ;;
          *) echo "mmw: 认不出参数 $1" >&2; usage_skills ;;
        esac
      done
      [ -n "$host" ] || { echo "mmw: skills materialize 要 --host" >&2; usage_skills; }
      args+=(--host "$host")
      python3 "$MMW_ROOT/cli/lib/materialize_skills.py" "${args[@]}"
      ;;
    *) usage_skills ;;
  esac
}

# 派出去的那一侧从哪个路径读方法论。宿主自己会送到位的，什么都不输出。
cmd_skill_path() {
  local role="${1:-}"
  [ -n "$role" ] || usage_skill_path
  role_roster "$role" >/dev/null || {
    echo "mmw: 认不出角色 $role" >&2
    usage_skill_path
  }
  local skill
  skill="$(role_skill "$role")"
  [ -n "$skill" ] || return 0

  local host adapter
  host="$(mmw_host)"
  if [ "$host" = "codex" ]; then
    return 0
  fi
  adapter="$MMW_ROOT/cli/adapters/$host.sh"
  [ -f "$adapter" ] || { echo "mmw: 没有 $host 的 adapter" >&2; return 1; }
  # shellcheck source=/dev/null
  . "$adapter"
  mmw_adapter_skill_path "$skill" "$(mmw_model_field "$role" family)"
}

cmd_task() {
  local host
  host="$(mmw_host)" || return 1
  local sub="${1:-}"
  shift || true
  case "$sub" in
    state) [ $# -eq 0 ] || usage_task; mmw_task_state ;;
    bind) [ "$host" = "codex" ] || { echo "mmw: task bind 只用于 Codex App 已创建的 detached worktree" >&2; return 1; }; mmw_task_bind "$@" ;;
    new) [ "$host" != "codex" ] || { echo "mmw: Codex App 负责创建 worktree，这里只用 task bind" >&2; return 1; }; mmw_task_new "$@" ;;
    enter) [ "$host" != "codex" ] || { echo "mmw: Codex App 任务不切换工作根目录" >&2; return 1; }; mmw_task_enter "$@" ;;
    cleanup) [ "$host" != "codex" ] || { echo "mmw: Codex App 负责清理 managed worktree" >&2; return 1; }; mmw_task_cleanup "$@" ;;
    *) usage_task ;;
  esac
}

cmd_result() {
  local sub="${1:-}"
  shift || true
  case "$sub" in
    verify) mmw_result_verify "$@" ;;
    integrate) mmw_result_integrate "$@" ;;
    *) usage_result ;;
  esac
}

cmd_issue() {
  local sub="${1:-}"
  shift || true
  case "$sub" in
    create) mmw_issue_create "$@" ;;
    children) [ -n "${1:-}" ] || usage_issue; mmw_issue_children "$1" ;;
    claim) [ -n "${1:-}" ] || usage_issue; mmw_issue_claim "$1" ;;
    frontier)
      local parent="${1:-}" label=""
      [ -n "$parent" ] || usage_issue
      shift
      while [ $# -gt 0 ]; do
        case "$1" in
          --label) label="${2:-}"; shift 2 ;;
          *) echo "mmw: issue frontier 认不出参数 $1" >&2; usage_issue ;;
        esac
      done
      mmw_issue_frontier "$parent" "$label"
      ;;
    link)
      local child="${1:-}" blocker=""
      [ -n "$child" ] || usage_issue
      shift
      while [ $# -gt 0 ]; do
        case "$1" in
          --blocked-by) blocker="${2:-}"; shift 2 ;;
          *) echo "mmw: issue link 认不出参数 $1" >&2; usage_issue ;;
        esac
      done
      [ -n "$blocker" ] || { echo "mmw: issue link 要 --blocked-by" >&2; usage_issue; }
      mmw_issue_link "$child" "$blocker"
      ;;
    *) usage_issue ;;
  esac
}

cmd_wiki() {
  local sub="${1:-}"
  shift || true
  case "$sub" in
    ensure) mmw_wiki_ensure ;;
    nav) mmw_wiki_nav ;;
    verify) [ -n "${1:-}" ] || usage_wiki; mmw_wiki_verify "$1" ;;
    *) usage_wiki ;;
  esac
}

cmd_domain() {
  local sub="${1:-}"
  shift || true
  [ $# -eq 0 ] || usage_domain
  case "$sub" in
    path) mmw_domain_path ;;
    map-init) mmw_domain_map_init ;;
    sync) mmw_domain_sync ;;
    check) mmw_domain_check ;;
    adr-next) mmw_domain_adr_next ;;
    dirs) mmw_domain_dirs ;;
    *) usage_domain ;;
  esac
}

usage_graph() {
  cat >&2 <<'EOF'
mmw graph status   图新不新鲜：FRESH / STALE / MISSING
mmw graph ensure   对不上当前代码才建。任务 worktree 里先看主仓库那份能不能直接用
mmw graph build    不管新不新鲜都重建一次，也不复用。配置刚改完时用它
mmw graph verify   图里各类关系各有多少条，够不够用

判据与构建都在 mcp/graphify_ensure.py，这四条只是它的入口。
EOF
  return 2
}

usage_mcp() {
  cat >&2 <<'EOF'
mmw mcp serve <服务器名>
    从 mmw/.mcp.json 展开并启动一台 stdio MCP 服务器。
    这是 Codex plugin 的进程入口，不安装用户级 MCP 配置。
EOF
  return 2
}

cmd_mcp() {
  local sub="${1:-}"
  shift || true
  case "$sub" in
    serve)
      [ $# -eq 1 ] || usage_mcp
      exec python3 "$MMW_ROOT/mcp/serve.py" "$1"
      ;;
    *) usage_mcp ;;
  esac
}

cmd_graph() {
  case "${1:-}" in
    status) mmw_graph_status ;;
    ensure) mmw_graph_ensure ;;
    build) mmw_graph_build ;;
    verify) mmw_graph_verify ;;
    *) usage_graph ;;
  esac
}

cmd_doctor() {
  local host status=0 domain_ready=0
  echo "CLI      : ${BASH_SOURCE[0]} -> $MMW_ROOT"
  if host="$(mmw_host 2>/dev/null)"; then
    echo "宿主     : $host"
  else
    echo "宿主     : 认不出（Claude Code、Pi 与 Codex 标识都没有）"
    status=1
  fi
  if git rev-parse --show-toplevel >/dev/null 2>&1; then
    echo "仓库     : $(mmw_repo_root)"
    if [ -f "$(mmw_config_path)" ]; then
      echo "配置     : $(mmw_config_path)"
      domain_ready=1
    else
      echo "配置     : 缺 .mmw.json，跑 mmw init"
      status=1
    fi
  else
    echo "仓库     : 当前目录不在 git 仓库里"
    status=1
  fi
  if [ "$domain_ready" -eq 1 ] && [ -n "${host:-}" ]; then
    local domain_out domain_prefix domain_shape domain_path domain_state
    if domain_out="$(mmw_domain_check 2>&1)"; then
      IFS=$'\t' read -r domain_prefix domain_shape domain_path domain_state <<< "$domain_out"
      if [ "$domain_prefix" = "check" ] && [ "$domain_state" = "valid" ]; then
        echo "领域合同 : valid shape=${domain_shape} path=${domain_path}"
      else
        echo "领域合同 : invalid"
        printf '%s\n' "$domain_out" | sed 's/^/           /'
        status=1
      fi
    else
      echo "领域合同 : invalid"
      printf '%s\n' "$domain_out" | sed 's/^/           /'
      status=1
    fi
  fi
  command -v jq >/dev/null && echo "jq       : $(command -v jq)" || { echo "jq       : 没装"; status=1; }
  command -v gh >/dev/null && echo "gh       : $(command -v gh)" || { echo "gh       : 没装"; status=1; }
  # Wiki 没有 API，读写一律 clone 加 push，走 https://github.com/<仓库>.wiki.git
  # （见 lib/wiki.sh）。凭据助手没配好的话，要等到 /mmw-closing 第 5 步、用户
  # 已经点头同意推送之后才发现推不上去。这里提前探一次：喂一条 github.com 的
  # https 查询，走完整条助手链，只判有没有人答上密码，不回显。
  if printf 'protocol=https\nhost=github.com\n\n' \
     | GIT_TERMINAL_PROMPT=0 git credential fill 2>/dev/null | grep -q '^password='; then
    echo "推送鉴权 : github.com 的 https 凭据有人答得上"
  else
    echo "推送鉴权 : github.com 的 https 凭据没人答得上，跑 gh auth setup-git（推 Wiki 要它）"
    status=1
  fi
  if [ "${host:-}" = "claude-code" ]; then
    command -v codex >/dev/null \
      && echo "codex    : $(command -v codex)" \
      || { echo "codex    : 没装（这个宿主派 GPT 要它）"; status=1; }
    local agent_skills="${CODEX_HOME:-$HOME/.codex}/skills"
    if [ -e "$agent_skills/mmw-reviewer" ]; then
      echo "方法论   : 已装进 $agent_skills"
    else
      # 绝对路径。插件装出去之后，读这行的 agent 待在用户自己的仓库里，
      # 那里没有 mmw/ 这个目录，相对路径它跑不了。
      echo "方法论   : 没装，跑 $MMW_ROOT/cli/lib/install-agent-skills.sh"
      status=1
    fi
  elif [ "${host:-}" = "pi" ]; then
    command -v claude >/dev/null \
      && echo "claude   : $(command -v claude)（pi 派 Claude 靠它桥接）" \
      || { echo "claude   : 没装（pi 派 Claude 要它）"; status=1; }
    echo "方法论   : 走 subagent 的 skill 参数，不用安装"
  elif [ "${host:-}" = "codex" ]; then
    if python3 "$MMW_ROOT/codex/runtime.py" check >/dev/null 2>&1; then
      echo "Codex    : 四个原生 subagent 与 mmw 转发脚本已安装"
    else
      echo "Codex    : 运行时未装或过期，跑 python3 $MMW_ROOT/codex/runtime.py install"
      status=1
    fi
    echo "方法论   : 由 Codex plugin 直接提供，不用装旧 Claude bridge"
  fi

  case "${host:-}" in
    pi)
      if python3 "$MMW_ROOT/cli/lib/materialize_agents.py" --host pi --check >/dev/null 2>&1; then
        echo "Pi agent : agents-pi 与 agent-src / 型号表一致"
      else
        echo "Pi agent : 与真源不一致，跑 mmw agents materialize --host pi"
        status=1
      fi
      if python3 "$MMW_ROOT/cli/lib/materialize_skills.py" --host pi --check >/dev/null 2>&1; then
        echo "Pi skills: skills-pi 与 skills/ 源一致"
      else
        echo "Pi skills: 与真源不一致，跑 mmw skills materialize --host pi"
        status=1
      fi
      ;;
    claude-code)
      if python3 "$MMW_ROOT/cli/lib/materialize_skills.py" --host claude-code --check >/dev/null 2>&1; then
        echo "CC skills: skills-claude-code 与 skills/ 源一致"
      else
        echo "CC skills: 与真源不一致，跑 mmw skills materialize --host claude-code"
        status=1
      fi
      ;;
    codex)
      if python3 "$MMW_ROOT/codex/runtime.py" materialize --check >/dev/null 2>&1; then
        echo "Codex src: plugin、agent 与 profiles 一致"
      else
        echo "Codex src: 生成物漂移，跑 python3 $MMW_ROOT/codex/runtime.py materialize"
        status=1
      fi
      ;;
  esac

  # Pi 与 Cursor 的插件规格没有声明 MCP 的位置，只能写用户级配置。Codex plugin
  # 自己携带 MCP，不能让另外两个宿主的本机安装状态把 Codex 体检判红。
  if [ "${host:-}" != "codex" ]; then
    if bash "$MMW_ROOT/mcp/install-mcp.sh" --check >/dev/null 2>&1; then
      echo "pi/Cursor: 用户级 MCP 已装（这台机器上没有的那一面自动跳过）"
    else
      echo "pi/Cursor: 有一面没装或与插件定义不一致，跑 $MMW_ROOT/mcp/install-mcp.sh"
      status=1
    fi
  else
    local codex_config project_codex_config
    codex_config="${CODEX_HOME:-$HOME/.codex}/config.toml"
    project_codex_config=""
    if git rev-parse --show-toplevel >/dev/null 2>&1; then
      project_codex_config="$(mmw_repo_root)/.codex/config.toml"
    fi
    local mcp_config_error
    if mcp_config_error="$(python3 "$MMW_ROOT/codex/runtime.py" check-mcp-config \
      "$codex_config" "$project_codex_config" 2>&1)"; then
      echo "Codex MCP: 三台服务器由 plugin 或等价的 mmw 项目入口启动"
    else
      echo "Codex MCP: 旧手工命令正在绕过 plugin："
      printf '%s\n' "$mcp_config_error" | sed 's/^/           /'
      status=1
    fi
  fi

  # 密钥只报来源不报值。没配不算故障——三个服务器都能不带密钥跑，只是额度小。
  local secrets
  secrets="$(python3 "$MMW_ROOT/mcp/resolve.py" 2>&1)" || secrets="展开器跑不起来：$secrets"
  printf '密钥     : %s\n' "$(printf '%s' "$secrets" | head -1)"
  printf '%s\n' "$secrets" | tail -n +2 | sed 's/^/           /'

  # 真把每个服务器拉起来握一次手，不只看配置在不在——旧实现出过一次事故：配置在、
  # 工具名在列表里、直到模型真去调用才报错，那时它已经在一次审查中途了。
  local probe_out
  local -a probe_args=()
  if [ "${host:-}" = "codex" ]; then
    probe_args+=(--config "$MMW_ROOT/.mcp-codex.json")
  fi
  if probe_out="$(python3 "$MMW_ROOT/mcp/probe.py" "${probe_args[@]}" 2>&1)"; then
    printf '检索工具 : %s\n' "$(printf '%s' "$probe_out" | head -1)"
    printf '%s\n' "$probe_out" | tail -n +2 | sed 's/^/           /'
  else
    printf '检索工具 : 有起不来的，下面这几行说的是哪一个\n'
    printf '%s\n' "$probe_out" | sed 's/^/           /'
    echo "           Serena 与 Graphify 是两个 Python 工具包，插件替不了你装："
    echo "           uv tool install serena-agent && uv tool install graphifyy"
    status=1
  fi
  return $status
}


case "${1:-}" in
  dispatch) shift; cmd_dispatch "$@" ;;
  agents) shift; cmd_agents "$@" ;;
  skills) shift; cmd_skills "$@" ;;
  skill-path) shift; cmd_skill_path "$@" ;;
  task) shift; cmd_task "$@" ;;
  result) shift; cmd_result "$@" ;;
  issue) shift; cmd_issue "$@" ;;
  wiki) shift; cmd_wiki "$@" ;;
  domain) shift; cmd_domain "$@" ;;
  graph) shift; cmd_graph "$@" ;;
  mcp) shift; cmd_mcp "$@" ;;
  release) shift; exec bash "$MMW_ROOT/release/release-flow.sh" "$@" ;;
  doctor) shift; cmd_doctor "$@" ;;
  init) shift; mmw_init "$@" ;;
  *) usage ;;
esac
