#!/usr/bin/env bash
# mmw：多模型开发编排的机械层。
#
# 每条命令是（仓库，参数）的纯函数：不写状态文件，不记得上一步是什么。走到哪
# 一步由技能决定，这里永远不知道。
#
# 这里也不放 git push、不放远端合并、不放部署。宿主的命令白名单一旦放行
# `mmw`，CLI 内部起的 git 与 gh 子进程就不再经过宿主的权限层，那三件事必须留
# 在外面由人决定。

set -euo pipefail

MMW_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=lib/config.sh
. "$MMW_ROOT/cli/lib/config.sh"
# shellcheck source=lib/task.sh
. "$MMW_ROOT/cli/lib/task.sh"
# shellcheck source=lib/issue.sh
. "$MMW_ROOT/cli/lib/issue.sh"
# shellcheck source=lib/wiki.sh
. "$MMW_ROOT/cli/lib/wiki.sh"
# shellcheck source=lib/domain.sh
. "$MMW_ROOT/cli/lib/domain.sh"
# shellcheck source=lib/graph.sh
. "$MMW_ROOT/cli/lib/graph.sh"
# shellcheck source=lib/init.sh
. "$MMW_ROOT/cli/lib/init.sh"

# 用法分两层：这里只列命令名，参数在各命令自己的 usage_* 里。要查 dispatch
# 怎么写的人不该顺带读完 issue 的六个子命令——认不出参数时打的也是那一个命令
# 自己的用法，不是全部。
usage() {
  cat >&2 <<'EOF'
mmw <命令> [参数]

  dispatch    把一件任务派给隔离上下文的 subagent
  agents      把角色物化成宿主原生 subagent 文件
  skill-path  派出去那一侧读方法论的路径
  task        任务 worktree：建、进、删
  issue       tracker：建 issue、挂父子、算可认领集合
  wiki        Wiki：clone、重建导航、删本地文档前的验证
  domain      领域文档：落点、下一个 ADR 编号
  graph       结构图谱：状态、建一次、验证建对了
  release     出包：起循环、问状态、跑一个阶段、派修、收束
  doctor      检查这台机器上跑 mmw 需要的东西（无参：跑一次就是检查）
  init        把当前仓库配置成能跑这套工作流的样子；幂等（无参：跑一次就是配置）

前九条不带参数跑一次，给它自己的用法。doctor 与 init 本来就不收参数，
跑它们就是执行——查它们做什么看上面这两行，不要拿跑一次当查用法。
EOF
  return 2
}

usage_dispatch() {
  cat >&2 <<'EOF'
mmw dispatch <角色> --brief <文件> [--cwd <目录>]

角色：
  worker            按一份 plan 写代码
  worker-high-risk  同上，但这块代码错了代价大
  planner           按一张 ticket 写一份 plan
  investigator      查一个角度的事实，带出处交回
  reviewer-gpt      审查，GPT 那一侧
  reviewer-claude   审查，Claude 那一侧

参数：
  --brief <文件>  提示词文件，必填
  --cwd <目录>    它待着的目录。前三个角色会写文件，必填，指向它那棵 worktree；
                  只读的三个不给就是仓库根

模型、档位、护栏由角色决定，取自仓库根 .mmw.json，这里不用管。

返回开头一行是 mode: executed 或 mode: host-tool，两种读法不一样，
判据在 mmw-dispatching-agents。
EOF
  return 2
}

usage_skill_path() {
  cat >&2 <<'EOF'
mmw skill-path <角色>

角色：worker、worker-high-risk、planner、investigator、reviewer-gpt、reviewer-claude

输出派出去那一侧读方法论的绝对路径，写进给它的提示词里。
宿主自己会把方法论送到位的角色什么都不输出，那时这句话省掉。
EOF
  return 2
}

usage_task() {
  cat >&2 <<'EOF'
mmw task new <slug> [原话] [--from <基点>]
    建 worktree 与分支，输出绝对路径。原话记进分支上的第一个空提交。
    不给 --from 就从当前 HEAD 分叉
mmw task enter <slug>       输出该 worktree 的绝对路径
mmw task cleanup <slug>     删 worktree 与分支；非强制，有未提交改动会失败

切进 worktree 只有宿主工具做得到，这条命令只输出路径。
EOF
  return 2
}

usage_issue() {
  cat >&2 <<'EOF'
mmw issue create --title <标题> --body-file <文件>
                 [--parent <n>] [--blocked-by <n,n>] [--label <a,b>]
    建 issue、挂父、连阻塞边、打标签，输出编号
mmw issue frontier <父编号> [--label <标签>]
    open、没被挡、没人认领的子 issue，编号升序。要全部的读全部行，
    要下一张的取第一行。每行两列，制表符分隔：编号、标题
mmw issue children <父编号>
    全部子 issue，编号升序，看任务走到哪一步。每行四列，制表符分隔：
    编号、标题、认领人（无人为空）、被几张还开着的 issue 挡着
mmw issue claim <编号>               认领；已被别人占住就失败
mmw issue link <子> --blocked-by <n> 单连一条阻塞边

--label 的取值由点名它的那个技能给，这里不列。
EOF
  return 2
}

usage_wiki() {
  cat >&2 <<'EOF'
mmw wiki ensure         clone 或 pull Wiki，输出本地路径
mmw wiki nav            从各页面重新生成 Home.md 与 _Sidebar.md
mmw wiki verify <slug>  删本地文档前那三条验证

推 Wiki 是对外发布，要用户点头，这里不做。
EOF
  return 2
}

usage_domain() {
  cat >&2 <<'EOF'
mmw domain path      领域文档形态与落点，第三列写着照它做什么
mmw domain adr-next  下一个 ADR 编号，四位零填充
mmw domain dirs      写入侧的两个落点：新上下文的根目录、ADR 目录
EOF
  return 2
}

# 角色的产品语义：用哪份花名册、挂哪份方法论、要不要写权限。
# 这三样两个宿主完全相同，所以留在这里，不进 adapter。
role_roster() {
  case "$1" in
    worker) echo "mmw-worker" ;;
    worker-high-risk) echo "mmw-worker-high-risk" ;;
    planner) echo "mmw-planner" ;;
    investigator) echo "mmw-investigator" ;;
    reviewer-gpt) echo "mmw-reviewer-gpt" ;;
    reviewer-claude) echo "mmw-reviewer-claude" ;;
    *) return 1 ;;
  esac
}

# 挂哪份方法论。调查者没有——它每次的判据由派它的技能现写进提示词。
role_skill() {
  case "$1" in
    worker | worker-high-risk) echo "mmw-tdd" ;;
    planner) echo "mmw-planner" ;;
    reviewer-gpt | reviewer-claude) echo "mmw-reviewer" ;;
    *) echo "" ;;
  esac
}

role_writable() {
  case "$1" in
    investigator | reviewer-gpt | reviewer-claude) echo "no" ;;
    *) echo "yes" ;;
  esac
}

cmd_dispatch() {
  local role="${1:-}"
  shift || true
  [ -n "$role" ] || usage_dispatch

  local roster skill
  roster="$(role_roster "$role")" || {
    echo "mmw: 认不出角色 $role" >&2
    usage_dispatch
  }
  skill="$(role_skill "$role")"

  local brief="" cwd=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --brief) brief="${2:-}"; shift 2 ;;
      --cwd) cwd="${2:-}"; shift 2 ;;
      *) echo "mmw: 认不出参数 $1" >&2; usage_dispatch ;;
    esac
  done

  [ -n "$brief" ] || { echo "mmw: dispatch 要 --brief" >&2; usage_dispatch; }
  [ -f "$brief" ] || { echo "mmw: brief 文件不存在：$brief" >&2; return 1; }
  brief="$(cd "$(dirname "$brief")" && pwd)/$(basename "$brief")"

  local writable
  writable="$(role_writable "$role")"
  # 会写文件的角色必须显式指定工作目录：它要待在自己那棵 worktree 里，
  # 默认到仓库根就会写进主工作树。只读角色默认在仓库根，没有这个风险。
  if [ "$writable" = "yes" ] && [ -z "$cwd" ]; then
    echo "mmw: $role 会写文件，--cwd 必填，指向它该待的那棵 worktree" >&2
    return 1
  fi
  [ -n "$cwd" ] || cwd="$(mmw_repo_root)"
  [ -d "$cwd" ] || { echo "mmw: 工作目录不存在：$cwd" >&2; return 1; }
  cwd="$(cd "$cwd" && pwd)"

  local host adapter
  host="$(mmw_host)"
  adapter="$MMW_ROOT/cli/adapters/$host.sh"
  [ -f "$adapter" ] || { echo "mmw: 没有 $host 的 adapter" >&2; return 1; }

  export MMW_D_ROLE="$role"
  export MMW_D_ROSTER="$roster"
  export MMW_D_SKILL="$skill"
  export MMW_D_SKILL_PATH=""
  [ -z "$skill" ] || MMW_D_SKILL_PATH="$MMW_ROOT/skills/$skill/SKILL.md"
  export MMW_D_FAMILY MMW_D_MODEL_ID MMW_D_EFFORT
  MMW_D_FAMILY="$(mmw_model_field "$role" family)"
  MMW_D_MODEL_ID="$(mmw_model_field "$role" id)"
  MMW_D_EFFORT="$(mmw_model_field "$role" effort)"
  export MMW_D_BRIEF="$brief"
  export MMW_D_CWD="$cwd"
  export MMW_D_WRITABLE="$writable"

  # 可写任务派出去之前工作区必须干净，否则工人的提交里会混进别人的改动。
  if [ "$MMW_D_WRITABLE" = "yes" ] && [ -n "$(git -C "$cwd" status --porcelain)" ]; then
    echo "mmw: $cwd 工作区不干净，可写任务不派" >&2
    git -C "$cwd" status --short >&2
    return 1
  fi

  # shellcheck source=/dev/null
  . "$adapter"
  mmw_adapter_dispatch
}

usage_agents() {
  cat >&2 <<'EOF'
mmw agents materialize --host <pi|cursor|all> [--check] [--config <文件>] [--out <目录>]

把 agent-src/roles.json 与 .mmw.json（或 --config）里的型号表，按
agent-src/profiles/<host>.json 物化成该宿主原生 subagent 文件。

  --host     pi：写入插件 agents-pi/；cursor：写入 ~/.cursor/agents/；all：两个都写
  --check    只比对，漂移非零退出
  --config   型号表路径；默认用插件 cli/mmw.default.json
  --out      覆盖该次宿主的输出目录（不能与 --host all 同用）

型号、思考档、后台、隔离默认值写进 frontmatter。主 agent 调用时只交
agent 名、task（brief 全文）和可写角色的 cwd。
EOF
  return 2
}

cmd_agents() {
  local sub="${1:-}"
  shift || true
  case "$sub" in
    materialize)
      local host=""
      local -a args=()
      while [ $# -gt 0 ]; do
        case "$1" in
          --host) host="${2:-}"; shift 2 ;;
          --check) args+=(--check); shift ;;
          --config)
            [ -n "${2:-}" ] || { echo "mmw: --config 要路径" >&2; usage_agents; }
            args+=(--config "$2"); shift 2
            ;;
          --out)
            [ -n "${2:-}" ] || { echo "mmw: --out 要目录" >&2; usage_agents; }
            args+=(--out "$2"); shift 2
            ;;
          *) echo "mmw: 认不出参数 $1" >&2; usage_agents ;;
        esac
      done
      [ -n "$host" ] || { echo "mmw: agents materialize 要 --host" >&2; usage_agents; }
      args+=(--host "$host")
      python3 "$MMW_ROOT/cli/lib/materialize_agents.py" "${args[@]}"
      ;;
    *) usage_agents ;;
  esac
}

# 派出去的那一侧从哪个路径读方法论。宿主自己会送到位的，什么都不输出。
cmd_skill_path() {
  local role="${1:-}"
  [ -n "$role" ] || usage_skill_path
  role_roster "$role" >/dev/null || {
    echo "mmw: 认不出角色 $role" >&2
    usage_skill_path
  }
  local skill
  skill="$(role_skill "$role")"
  [ -n "$skill" ] || return 0

  local host adapter
  host="$(mmw_host)"
  adapter="$MMW_ROOT/cli/adapters/$host.sh"
  [ -f "$adapter" ] || { echo "mmw: 没有 $host 的 adapter" >&2; return 1; }
  # shellcheck source=/dev/null
  . "$adapter"
  mmw_adapter_skill_path "$skill" "$(mmw_model_field "$role" family)"
}

cmd_task() {
  local sub="${1:-}"
  shift || true
  case "$sub" in
    new) mmw_task_new "$@" ;;
    enter) mmw_task_enter "$@" ;;
    cleanup) mmw_task_cleanup "$@" ;;
    *) usage_task ;;
  esac
}

cmd_issue() {
  local sub="${1:-}"
  shift || true
  case "$sub" in
    create) mmw_issue_create "$@" ;;
    children) [ -n "${1:-}" ] || usage_issue; mmw_issue_children "$1" ;;
    claim) [ -n "${1:-}" ] || usage_issue; mmw_issue_claim "$1" ;;
    frontier)
      local parent="${1:-}" label=""
      [ -n "$parent" ] || usage_issue
      shift
      while [ $# -gt 0 ]; do
        case "$1" in
          --label) label="${2:-}"; shift 2 ;;
          *) echo "mmw: issue frontier 认不出参数 $1" >&2; usage_issue ;;
        esac
      done
      mmw_issue_frontier "$parent" "$label"
      ;;
    link)
      local child="${1:-}" blocker=""
      [ -n "$child" ] || usage_issue
      shift
      while [ $# -gt 0 ]; do
        case "$1" in
          --blocked-by) blocker="${2:-}"; shift 2 ;;
          *) echo "mmw: issue link 认不出参数 $1" >&2; usage_issue ;;
        esac
      done
      [ -n "$blocker" ] || { echo "mmw: issue link 要 --blocked-by" >&2; usage_issue; }
      mmw_issue_link "$child" "$blocker"
      ;;
    *) usage_issue ;;
  esac
}

cmd_wiki() {
  local sub="${1:-}"
  shift || true
  case "$sub" in
    ensure) mmw_wiki_ensure ;;
    nav) mmw_wiki_nav ;;
    verify) [ -n "${1:-}" ] || usage_wiki; mmw_wiki_verify "$1" ;;
    *) usage_wiki ;;
  esac
}

cmd_domain() {
  case "${1:-}" in
    path) mmw_domain_path ;;
    adr-next) mmw_domain_adr_next ;;
    dirs) mmw_domain_dirs ;;
    *) usage_domain ;;
  esac
}

usage_graph() {
  cat >&2 <<'EOF'
mmw graph status   图新不新鲜：FRESH / STALE / MISSING
mmw graph ensure   对不上当前代码才建。任务 worktree 里先看主仓库那份能不能直接用
mmw graph build    不管新不新鲜都重建一次，也不复用。配置刚改完时用它
mmw graph verify   图里各类关系各有多少条，够不够用

判据与构建都在 mcp/graphify_ensure.py，这四条只是它的入口。
EOF
  return 2
}

cmd_graph() {
  case "${1:-}" in
    status) mmw_graph_status ;;
    ensure) mmw_graph_ensure ;;
    build) mmw_graph_build ;;
    verify) mmw_graph_verify ;;
    *) usage_graph ;;
  esac
}

cmd_doctor() {
  local host status=0
  echo "CLI      : ${BASH_SOURCE[0]} -> $MMW_ROOT"
  if host="$(mmw_host 2>/dev/null)"; then
    echo "宿主     : $host"
  else
    echo "宿主     : 认不出（CLAUDECODE 与 PI_CODING_AGENT 都没设）"
    status=1
  fi
  if git rev-parse --show-toplevel >/dev/null 2>&1; then
    echo "仓库     : $(mmw_repo_root)"
    if [ -f "$(mmw_config_path)" ]; then
      echo "配置     : $(mmw_config_path)"
    else
      echo "配置     : 缺 .mmw.json，跑 mmw init"
      status=1
    fi
  else
    echo "仓库     : 当前目录不在 git 仓库里"
    status=1
  fi
  command -v jq >/dev/null && echo "jq       : $(command -v jq)" || { echo "jq       : 没装"; status=1; }
  command -v gh >/dev/null && echo "gh       : $(command -v gh)" || { echo "gh       : 没装"; status=1; }
  # Wiki 没有 API，读写一律 clone 加 push，走 https://github.com/<仓库>.wiki.git
  # （见 lib/wiki.sh）。凭据助手没配好的话，要等到 /mmw-closing 第 5 步、用户
  # 已经点头同意推送之后才发现推不上去。这里提前探一次：喂一条 github.com 的
  # https 查询，走完整条助手链，只判有没有人答上密码，不回显。
  if printf 'protocol=https\nhost=github.com\n\n' \
     | GIT_TERMINAL_PROMPT=0 git credential fill 2>/dev/null | grep -q '^password='; then
    echo "推送鉴权 : github.com 的 https 凭据有人答得上"
  else
    echo "推送鉴权 : github.com 的 https 凭据没人答得上，跑 gh auth setup-git（推 Wiki 要它）"
    status=1
  fi
  if [ "${host:-}" = "claude-code" ]; then
    command -v codex >/dev/null \
      && echo "codex    : $(command -v codex)" \
      || { echo "codex    : 没装（这个宿主派 GPT 要它）"; status=1; }
    local agent_skills="${CODEX_HOME:-$HOME/.codex}/skills"
    if [ -e "$agent_skills/mmw-reviewer" ]; then
      echo "方法论   : 已装进 $agent_skills"
    else
      # 绝对路径。插件装出去之后，读这行的 agent 待在用户自己的仓库里，
      # 那里没有 mmw/ 这个目录，相对路径它跑不了。
      echo "方法论   : 没装，跑 $MMW_ROOT/skills/mmw-dispatching-agents/install-agent-skills.sh"
      status=1
    fi
  elif [ "${host:-}" = "pi" ]; then
    command -v claude >/dev/null \
      && echo "claude   : $(command -v claude)（pi 派 Claude 靠它桥接）" \
      || { echo "claude   : 没装（pi 派 Claude 要它）"; status=1; }
    echo "方法论   : 走 subagent 的 skill 参数，不用安装"
  fi

  if python3 "$MMW_ROOT/cli/lib/materialize_agents.py" --host pi --check >/dev/null 2>&1; then
    echo "Pi agent : agents-pi 与 agent-src / 默认型号表一致"
  else
    echo "Pi agent : 与真源不一致，跑 mmw agents materialize --host pi"
    status=1
  fi
  if python3 "$MMW_ROOT/cli/lib/materialize_agents.py" --host cursor --check >/dev/null 2>&1; then
    echo "Cursor   : ~/.cursor/agents 与真源一致"
  else
    echo "Cursor   : 未装或过期，跑 mmw agents materialize --host cursor"
  fi

  # pi 与 Cursor 的插件规格都没有声明 MCP 的位置，只能写用户级配置。不按当前宿主
  # 分支报：在 Claude Code 里也要看得见另外两面装没装，否则换个宿主才发现断了。
  if bash "$MMW_ROOT/mcp/install-mcp.sh" --check >/dev/null 2>&1; then
    echo "pi/Cursor: 用户级 MCP 已装（这台机器上没有的那一面自动跳过）"
  else
    echo "pi/Cursor: 有一面没装或与插件定义不一致，跑 $MMW_ROOT/mcp/install-mcp.sh"
    status=1
  fi

  # 密钥只报来源不报值。没配不算故障——三个服务器都能不带密钥跑，只是额度小。
  local secrets
  secrets="$(python3 "$MMW_ROOT/mcp/resolve.py" 2>&1)" || secrets="展开器跑不起来：$secrets"
  printf '密钥     : %s\n' "$(printf '%s' "$secrets" | head -1)"
  printf '%s\n' "$secrets" | tail -n +2 | sed 's/^/           /'

  # 真把每个服务器拉起来握一次手，不只看配置在不在——旧实现出过一次事故：配置在、
  # 工具名在列表里、直到模型真去调用才报错，那时它已经在一次审查中途了。
  local probe_out
  if probe_out="$(python3 "$MMW_ROOT/mcp/probe.py" 2>&1)"; then
    printf '检索工具 : %s\n' "$(printf '%s' "$probe_out" | head -1)"
    printf '%s\n' "$probe_out" | tail -n +2 | sed 's/^/           /'
  else
    printf '检索工具 : 有起不来的，下面这几行说的是哪一个\n'
    printf '%s\n' "$probe_out" | sed 's/^/           /'
    echo "           Serena 与 Graphify 是两个 Python 工具包，插件替不了你装："
    echo "           uv tool install serena-agent && uv tool install graphifyy"
    status=1
  fi
  return $status
}


case "${1:-}" in
  dispatch) shift; cmd_dispatch "$@" ;;
  agents) shift; cmd_agents "$@" ;;
  skill-path) shift; cmd_skill_path "$@" ;;
  task) shift; cmd_task "$@" ;;
  issue) shift; cmd_issue "$@" ;;
  wiki) shift; cmd_wiki "$@" ;;
  domain) shift; cmd_domain "$@" ;;
  graph) shift; cmd_graph "$@" ;;
  release) shift; exec bash "$MMW_ROOT/release/release-flow.sh" "$@" ;;
  doctor) shift; cmd_doctor "$@" ;;
  init) shift; mmw_init "$@" ;;
  *) usage ;;
esac
