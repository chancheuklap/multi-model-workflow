cmd_doctor() {
  local host status=0 domain_ready=0 repair repo_root="" config_path="" legacy_path legacy_spec key
  repair="$(mmw_install_repair_command)"
  echo "CLI      : ${BASH_SOURCE[0]} -> $MMW_ROOT"
  if host="$(mmw_host 2>/dev/null)"; then
    echo "宿主     : $host"
  else
    echo "宿主     : 认不出（Claude Code、Pi、Grok 与 Codex 标识都没有）"
    status=1
  fi
  if git rev-parse --show-toplevel >/dev/null 2>&1; then
    repo_root="$(mmw_repo_root)"
    config_path="$(mmw_config_path)"
    echo "仓库     : $repo_root"
    if [ -f "$config_path" ]; then
      echo "配置     : $config_path"
      domain_ready=1
    else
      echo "配置     : 缺 .mmw.json，跑 mmw init"
      status=1
    fi
  else
    echo "仓库     : 当前目录不在 git 仓库里"
    status=1
  fi
  if [ -n "$repo_root" ]; then
    if [ -d "$repo_root/docs/evidence" ]; then
      echo "历史产物 : 已退役路径 docs/evidence/"
    fi
    if [ -d "$repo_root/.dispatch" ]; then
      echo "历史产物 : 已退役路径 .dispatch/"
    fi
    for legacy_path in "$repo_root"/docs/specs/*; do
      [ -d "$legacy_path" ] || continue
      legacy_spec="$legacy_path/$(basename "$legacy_path").md"
      if [ -f "$legacy_spec" ]; then
        echo "历史产物 : 已退役路径 ${legacy_spec#"$repo_root"/}"
      fi
    done
  fi
  if [ -n "$config_path" ] && command -v jq >/dev/null \
     && jq empty "$config_path" >/dev/null 2>&1; then
    for key in specs plans prototypes research evidence; do
      if jq -e --arg key "$key" '(.paths? // {}) | has($key)' "$config_path" >/dev/null; then
        echo "遗留配置 : .mmw.json 的 paths.$key 已退役"
      fi
    done
    if jq -e 'has("wiki")' "$config_path" >/dev/null; then
      echo "遗留配置 : .mmw.json 的 wiki 已退役"
    fi
  fi
  if [ "$domain_ready" -eq 1 ] && [ -n "${host:-}" ]; then
    local domain_out domain_prefix domain_shape domain_path domain_state
    if domain_out="$(mmw_domain_check 2>&1)"; then
      IFS=$'\t' read -r domain_prefix domain_shape domain_path domain_state <<< "$domain_out"
      if [ "$domain_prefix" = "check" ] && [ "$domain_state" = "valid" ]; then
        echo "领域合同 : valid shape=${domain_shape} path=${domain_path}"
      else
        echo "领域合同 : invalid"
        printf '%s\n' "$domain_out" | sed 's/^/           /'
        status=1
      fi
    else
      echo "领域合同 : invalid"
      printf '%s\n' "$domain_out" | sed 's/^/           /'
      status=1
    fi
  fi
  command -v jq >/dev/null && echo "jq       : $(command -v jq)" || { echo "jq       : 没装"; status=1; }
  command -v gh >/dev/null && echo "gh       : $(command -v gh)" || { echo "gh       : 没装"; status=1; }
  # GitHub HTTPS 推送需要凭据助手。这里提前探一次：喂一条 github.com 的 https
  # 查询，走完整条助手链，只判有没有人答上密码，不回显。
  if printf 'protocol=https\nhost=github.com\n\n' \
     | GIT_TERMINAL_PROMPT=0 git credential fill 2>/dev/null | grep -q '^password='; then
    echo "推送鉴权 : github.com 的 https 凭据有人答得上"
  else
    echo "推送鉴权 : github.com 的 https 凭据没人答得上，跑 gh auth setup-git"
    status=1
  fi
  if [ "${host:-}" = "claude-code" ]; then
    command -v codex >/dev/null \
      && echo "codex    : $(command -v codex)" \
      || { echo "codex    : 没装（这个宿主派 GPT 要它）"; status=1; }
    local agent_skills="${CODEX_HOME:-$HOME/.codex}/skills"
    if [ -e "$agent_skills/mmw-reviewer" ]; then
      echo "方法论   : 已装进 $agent_skills"
    else
      # 绝对路径。插件装出去之后，读这行的 agent 待在用户自己的仓库里，
      # 那里没有 mmw/ 这个目录，相对路径它跑不了。
      echo "方法论   : 没装，重新运行 $repair"
      status=1
    fi
  elif [ "${host:-}" = "pi" ]; then
    command -v claude >/dev/null \
      && echo "claude   : $(command -v claude)（pi 派 Claude 靠它桥接）" \
      || { echo "claude   : 没装（pi 派 Claude 要它）"; status=1; }
    echo "方法论   : 走 subagent 的 skill 参数，不用安装"
  elif [ "${host:-}" = "codex" ]; then
    if python3 "$MMW_ROOT/codex/runtime.py" check >/dev/null 2>&1; then
      echo "Codex    : 四个原生 subagent 已安装"
    else
      echo "Codex    : 原生 subagent 未装或过期，重新运行 $repair"
      status=1
    fi
    echo "方法论   : 由 Codex plugin 直接提供"
  elif [ "${host:-}" = "grok" ]; then
    command -v grok >/dev/null \
      && echo "grok     : $(command -v grok)" \
      || { echo "grok     : 没装"; status=1; }
    if command -v agent >/dev/null; then
      echo "agent    : $(command -v agent)（不要把它当成 Grok CLI）"
    fi
    echo "方法论   : 走原生 subagent 与 ~/.grok/skills"
  fi

  case "${host:-}" in
    pi)
      if python3 "$MMW_ROOT/cli/lib/materialize_agents.py" --host pi --check >/dev/null 2>&1; then
        echo "Pi agent : agents-pi 与 agent-src / 模型档一致"
      else
        echo "Pi agent : 与 installed runtime 不一致，重新运行 $repair"
        status=1
      fi
      if python3 "$MMW_ROOT/cli/lib/materialize_skills.py" --host pi --check >/dev/null 2>&1; then
        echo "Pi skills: skills-pi 与 skills/ 源一致"
      else
        echo "Pi skills: 与 installed runtime 不一致，重新运行 $repair"
        status=1
      fi
      ;;
    claude-code)
      if python3 "$MMW_ROOT/cli/lib/materialize_skills.py" --host claude-code --check >/dev/null 2>&1; then
        echo "CC skills: skills-claude-code 与 skills/ 源一致"
      else
        echo "CC skills: 与 installed runtime 不一致，重新运行 $repair"
        status=1
      fi
      ;;
    codex)
      if python3 "$MMW_ROOT/codex/runtime.py" materialize --check >/dev/null 2>&1; then
        echo "Codex src: plugin、agent 与 profiles 一致"
      else
        echo "Codex src: installed runtime 内部不一致，重新运行 $repair"
        status=1
      fi
      ;;
    grok)
      if python3 "$MMW_ROOT/cli/lib/materialize_skills.py" --host grok --check >/dev/null 2>&1; then
        echo "Grok sk  : skills-grok 与技能源一致"
      else
        echo "Grok sk  : 与 installed runtime 不一致，重新运行 $repair"
        status=1
      fi
      if python3 "$MMW_ROOT/cli/lib/materialize_agents.py" --host grok --check >/dev/null 2>&1; then
        echo "Grok ag  : ~/.grok/agents 与 agent-src / 模型档一致"
      else
        echo "Grok ag  : 与 installed runtime 不一致，重新运行 $repair"
        status=1
      fi
      ;;
  esac

  # Pi 与 Cursor 的插件规格没有声明 MCP 的位置，只能写用户级配置。
  # Codex 与 Claude Code 的 plugin 自己携带 MCP。
  if [ "${host:-}" = "pi" ]; then
    if bash "$MMW_ROOT/mcp/install-mcp.sh" --check >/dev/null 2>&1; then
      echo "pi/Cursor: 用户级 MCP 已装（这台机器上没有的那一面自动跳过）"
    else
      echo "pi/Cursor: 有一面没装或与 plugin 定义不一致，重新运行 $repair"
      status=1
    fi
  elif [ "${host:-}" = "grok" ]; then
    if bash "$MMW_ROOT/mcp/install-mcp.sh" --check-grok >/dev/null 2>&1; then
      echo "Grok MCP : 用户级三台检索服务器已装"
    else
      echo "Grok MCP : 没装或与 plugin 定义不一致，重新运行 $repair"
      status=1
    fi
  elif [ "${host:-}" = "codex" ]; then
    local codex_config project_codex_config
    codex_config="${CODEX_HOME:-$HOME/.codex}/config.toml"
    project_codex_config=""
    if git rev-parse --show-toplevel >/dev/null 2>&1; then
      project_codex_config="$(mmw_repo_root)/.codex/config.toml"
    fi
    local mcp_config_error
    if mcp_config_error="$(python3 "$MMW_ROOT/codex/runtime.py" check-mcp-config \
      "$codex_config" "$project_codex_config" 2>&1)"; then
      echo "Codex MCP: 三台服务器由 plugin 或等价的 mmw 项目入口启动"
    else
      echo "Codex MCP: 旧手工命令正在绕过 plugin："
      printf '%s\n' "$mcp_config_error" | sed 's/^/           /'
      status=1
    fi
  fi

  # 密钥只报来源不报值。没配不算故障——三个服务器都能不带密钥跑，只是额度小。
  local secrets
  secrets="$(python3 "$MMW_ROOT/mcp/resolve.py" 2>&1)" || secrets="展开器跑不起来：$secrets"
  printf '密钥     : %s\n' "$(printf '%s' "$secrets" | head -1)"
  printf '%s\n' "$secrets" | tail -n +2 | sed 's/^/           /'

  # 真把每个服务器拉起来握一次手，不只看配置在不在——旧实现出过一次事故：配置在、
  # 工具名在列表里、直到模型真去调用才报错，那时它已经在一次审查中途了。
  local probe_out
  local -a probe_command=(python3 "$MMW_ROOT/mcp/probe.py")
  if [ "${host:-}" = "codex" ]; then
    probe_command+=(--config "$MMW_ROOT/.mcp-codex.json")
  fi
  if probe_out="$("${probe_command[@]}" 2>&1)"; then
    printf '检索工具 : %s\n' "$(printf '%s' "$probe_out" | head -1)"
    printf '%s\n' "$probe_out" | tail -n +2 | sed 's/^/           /'
  else
    printf '检索工具 : 有起不来的，下面这几行说的是哪一个\n'
    printf '%s\n' "$probe_out" | sed 's/^/           /'
    echo "           Serena 与 Graphify 是两个 Python 工具包，插件替不了你装："
    echo "           uv tool install serena-agent && uv tool install graphifyy"
    status=1
  fi
  return $status
}


case "${1:-}" in
  dispatch) shift; cmd_dispatch "$@" ;;
  agents) shift; cmd_agents "$@" ;;
  skills) shift; cmd_skills "$@" ;;
  artifact) shift; cmd_artifact "$@" ;;
  task) shift; cmd_task "$@" ;;
  result) shift; cmd_result "$@" ;;
  issue) shift; cmd_issue "$@" ;;
  domain) shift; cmd_domain "$@" ;;
  graph) shift; cmd_graph "$@" ;;
  toolchain) shift; cmd_toolchain "$@" ;;
  mcp) shift; cmd_mcp "$@" ;;
  release) shift; exec bash "$MMW_ROOT/release/release-flow.sh" "$@" ;;
  doctor) shift; cmd_doctor "$@" ;;
  init) shift; mmw_init "$@" ;;
  *) usage ;;
esac
