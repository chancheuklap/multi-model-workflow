#!/usr/bin/env bash
# mmw：多模型开发编排的机械层。
#
# 每条命令是（仓库，参数）的纯函数：不写状态文件，不记得上一步是什么。走到哪
# 一步由技能决定，这里永远不知道。
#
# 这里也不放 git push、不放远端合并、不放部署。宿主的命令白名单一旦放行
# `mmw`，CLI 内部起的 git 与 gh 子进程就不再经过宿主的权限层，那三件事必须留
# 在外面由人决定。

set -euo pipefail

MMW_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=lib/config.sh
. "$MMW_ROOT/cli/lib/config.sh"
# shellcheck source=lib/path.sh
. "$MMW_ROOT/cli/lib/path.sh"
# shellcheck source=lib/task.sh
. "$MMW_ROOT/cli/lib/task.sh"
# shellcheck source=lib/issue.sh
. "$MMW_ROOT/cli/lib/issue.sh"
# shellcheck source=lib/wiki.sh
. "$MMW_ROOT/cli/lib/wiki.sh"
# shellcheck source=lib/domain.sh
. "$MMW_ROOT/cli/lib/domain.sh"
# shellcheck source=lib/graph.sh
. "$MMW_ROOT/cli/lib/graph.sh"
# shellcheck source=lib/init.sh
. "$MMW_ROOT/cli/lib/init.sh"

# 用法分两层：这里只列命令名，参数在各命令自己的 usage_* 里。要查 dispatch
# 怎么写的人不该顺带读完 issue 的六个子命令——认不出参数时打的也是那一个命令
# 自己的用法，不是全部。
usage() {
  cat >&2 <<'EOF'
mmw <命令> [参数]

  dispatch    Claude Code：把 task 文件编成宿主工具参数（Pi 主路径不用）
  agents      把角色物化成宿主原生 subagent 文件
  skills      把技能源占位符物化成宿主写死的启动句
  task        任务 worktree：查状态、建、绑分支、进、删
  result      后台结果：验证分支并集成到当前任务
  issue       tracker：建 issue、挂父子、算可认领集合
  wiki        Wiki：clone、重建导航、删本地文档前的验证
  domain      领域文档：初始化 Map、同步和检查消费合同、查询落点与 ADR 编号
  graph       结构图谱：状态、建一次、验证建对了
  mcp         MCP：按唯一服务器定义启动 Codex plugin 的 stdio 进程
  release     出包：起循环、问状态、跑一个阶段、派修、收束
  doctor      检查这台机器上跑 mmw 需要的东西（无参：跑一次就是检查）
  init        把当前仓库配置成能跑这套工作流的样子；幂等（无参：跑一次就是配置）

除 doctor 与 init 外，各命令不带参数运行时只显示该命令的用法。doctor 与 init 不收参数，
跑它们就是执行——查它们做什么看上面这两行，不要拿跑一次当查用法。
EOF
  return 2
}

usage_dispatch() {
  cat >&2 <<'EOF'
mmw dispatch <角色> --task <文件> [--cwd <目录>]

角色：
  worker            按一份 plan 写代码
  worker-high-risk  同上，但这块代码错了代价大
  prototype-worker  做一个指定的原型变体
  planner           按一张 ticket 写一份 plan
  investigator      查一个角度的事实，带出处交回
  designer          按一个约束提出 interface 方案
  reviewer-gpt      审查，GPT 那一侧
  reviewer-claude   审查，Claude 那一侧

参数：
  --task <文件>   task 四栏表文件，必填（与 Pi 的 task 同一概念）
  --cwd <目录>    角色的工作目录。会写文件的角色必填；只读角色省略时使用仓库根

模型、档位、护栏由角色决定，取自仓库根 .mmw.json，这里不用管。

返回开头一行是 mode: executed 或 mode: host-tool。
host-tool 时原样用返回中的 params 调工具（params 内已含 task 正文或等价字段）。
EOF
  return 2
}

usage_task() {
  cat >&2 <<'EOF'
mmw task new <slug> [用户原话] [--from <基点分支或 SHA>]
    建任务 worktree 和同名分支，输出这个 worktree 的绝对路径。
    用户原话记进这条分支的第一个空提交，让后来的人知道这个任务从哪来。
    不给 --from 就从当前 HEAD 分叉；从 Wayfinding 的 map 分支派生时给 --from <map 分支>。
mmw task cleanup <slug>
    删掉这个 worktree 和它的分支。有未提交改动时失败，不强制删除。
mmw task state
    当前所在位置，输出 outside、local、detached、bound 之一。
mmw task bind <完整分支名> <用户原话或任务目标> [--from <预期基点>]
    Codex App 专用：把 App 已经建好的 detached worktree 绑到任务分支上。
    给了 --from 就先校验当前 HEAD 等于这个基点。

这条命令只输出路径；真正切进 worktree 要用宿主自己的工具。
在 Codex App 上只有 state 和 bind 可用，worktree 由 App 创建和清理；
在其他宿主上只有 state、new、cleanup 可用。
EOF
  return 2
}

usage_result() {
  cat >&2 <<'EOF'
mmw result verify <结果分支> <HEAD SHA> <基点 SHA>
    检查这条分支存在、它的 HEAD 等于给的 SHA、它确实从给的基点分叉、而且有新提交。
    通过时输出结果 worktree 的绝对路径，供你去那里读报告和 diff。不改任何 Git 状态。
mmw result integrate <结果分支> <HEAD SHA> <基点 SHA>
    先做一次同样的验证，再用 git merge --no-ff 把它合进当前分支。

三个参数都由交回结果的那一方给出，不要自己去查。SHA 对不上时退出码非 0，说明报告
和实际提交不一致：先查清楚差在哪，不要重试，也不要改用 git merge 绕过去。
EOF
  return 2
}

usage_issue() {
  cat >&2 <<'EOF'
mmw issue create --title <标题> --body-file <文件>
                 [--parent <编号>] [--blocked-by <编号,编号>] [--label <标签,标签>]
    建一张 issue，同时挂上父 issue、连好阻塞边、打好标签。只输出新 issue 的编号。
    --body-file 收的是文件路径，不是正文本身：正文先写进一个文件再传路径。
    --label 的取值来自正在使用这条命令的技能，例如 Wayfinder 用 wayfinder:map 和
    wayfinder:<类型>，To Spec 用 ready-for-agent。这条命令不校验标签含义。

mmw issue frontier <map 或父 issue 编号> [--label <标签> | --label-prefix <前缀>]
    列出 open、没有被还开着的 issue 挡住、也没有人认领的子 issue，编号升序。
    每行两列，制表符分隔：编号、标题。要全部就读全部行，要下一张就取第一行。
    一行都没有输出，说明当前没有可认领的子 issue，退出码仍然是 0。
    --label 和 --label-prefix 不能同时给。

mmw issue children <map 或父 issue 编号>
    列出全部子 issue，编号升序，用来看这一批走到哪一步了。每行六列，制表符分隔：
    编号、状态、认领人（无人认领时是 -）、还有几张开着的 issue 挡着它、
    标签（多个用逗号分隔）、标题。

mmw issue claim <编号>
    把这张 issue 认领给当前用户。已经被别人认领时退出码非 0，说明另一个会话正在
    处理它：改取下一张，不要重试。

mmw issue link <被挡的编号> --blocked-by <挡住它的编号>
    连一条阻塞边。一次只连一条，要连多条就多跑几次。

以上五条之外的 tracker 动作直接用 gh：
    读 issue 和评论   gh issue view <编号> --comments
    发评论            gh issue comment <编号> --body-file <文件>
    改正文            gh issue edit <编号> --body-file <文件>
    关 issue          gh issue close <编号>
EOF
  return 2
}

usage_wiki() {
  cat >&2 <<'EOF'
mmw wiki ensure         clone 或 pull Wiki，输出本地路径
mmw wiki nav            从各页面重新生成 Home.md 与 _Sidebar.md
mmw wiki verify <slug>  删本地文档前那三条验证

推 Wiki 是对外发布，要用户点头，这里不做。
EOF
  return 2
}

usage_domain() {
  cat >&2 <<'EOF'
mmw domain adr-next
    下一个可用的 ADR 编号，四位零填充，例如 0007。每次调用都重新扫描 adr 目录。
    多个会话可能并行写 ADR 时不要提前取号：先用 draft-<标识>-<slug>.md 命名，
    等结果合回主干之后再取正式编号。

mmw domain map-init
    这个仓库确实有多个 bounded context 时，创建 Context Map 骨架。
    Map 已经存在时失败，不覆盖。

mmw domain sync
    把 MMW 管理的那段提示写进 AGENTS.md 和 Context Map，可以重复运行。
    创建或修改 Context Map、leaf 之后跑一次。

mmw domain check
    检查那段提示和 Context Map 的结构是否完整。退出码非 0 时按输出修好，
    这次修改才算完成。
EOF
  return 2
}

# 角色的产品语义：agent 名、方法论、是否可写。唯一事实来源是 agent-src/roles.json。
role_roster() {
  agents_role_field "$1" agent
}

role_skill() {
  agents_role_field "$1" skill
}

role_writable() {
  local w
  w="$(agents_role_field "$1" writable)" || return 1
  if [ "$w" = "true" ]; then
    echo yes
  else
    echo no
  fi
}

# 从 agent-src/roles.json 读角色字段。
agents_role_field() {
  local role="$1" field="$2"
  local path="$MMW_ROOT/agent-src/roles.json"
  [ -f "$path" ] || { echo "mmw: 找不到 $path" >&2; return 1; }
  jq -e --arg r "$role" '.roles | has($r)' "$path" >/dev/null 2>&1 || return 1
  case "$field" in
    agent)
      jq -er --arg r "$role" '.roles[$r].agent' "$path"
      ;;
    skill)
      jq -r --arg r "$role" '.roles[$r].skill // empty' "$path"
      ;;
    writable)
      jq -r --arg r "$role" 'if .roles[$r].writable then "true" else "false" end' "$path"
      ;;
    *)
      return 1
      ;;
  esac
}

cmd_dispatch() {
  local role="${1:-}"
  shift || true
  [ -n "$role" ] || usage_dispatch

  local roster skill
  roster="$(role_roster "$role")" || {
    echo "mmw: 认不出角色 $role" >&2
    usage_dispatch
  }
  skill="$(role_skill "$role")"

  local task="" cwd=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --task) task="${2:-}"; shift 2 ;;
      --cwd) cwd="${2:-}"; shift 2 ;;
      *) echo "mmw: 认不出参数 $1" >&2; usage_dispatch ;;
    esac
  done

  [ -n "$task" ] || { echo "mmw: dispatch 要 --task" >&2; usage_dispatch; }
  [ -f "$task" ] || { echo "mmw: task 文件不存在：$task" >&2; return 1; }
  task="$(cd "$(dirname "$task")" && pwd)/$(basename "$task")"

  local writable
  writable="$(role_writable "$role")"
  # 会写文件的角色必须显式指定工作目录：它要待在自己那棵 worktree 里，
  # 默认到仓库根就会写进主工作树。只读角色默认在仓库根，没有这个风险。
  if [ "$writable" = "yes" ] && [ -z "$cwd" ]; then
    echo "mmw: $role 会写文件，--cwd 必填，指向它该待的那棵 worktree" >&2
    return 1
  fi
  [ -n "$cwd" ] || cwd="$(mmw_repo_root)"
  [ -d "$cwd" ] || { echo "mmw: 工作目录不存在：$cwd" >&2; return 1; }
  cwd="$(cd "$cwd" && pwd)"

  local host adapter
  host="$(mmw_host)"
  adapter="$MMW_ROOT/cli/adapters/$host.sh"
  [ -f "$adapter" ] || { echo "mmw: 没有 $host 的 adapter" >&2; return 1; }

  export MMW_D_ROLE="$role"
  export MMW_D_ROSTER="$roster"
  export MMW_D_FAMILY MMW_D_MODEL_ID MMW_D_EFFORT
  MMW_D_FAMILY="$(mmw_model_field "$role" family)"
  MMW_D_MODEL_ID="$(mmw_model_field "$role" id)"
  MMW_D_EFFORT="$(mmw_model_field "$role" effort)"
  export MMW_D_TASK="$task"
  export MMW_D_CWD="$cwd"
  export MMW_D_WRITABLE="$writable"

  # 可写：必须是干净任务 worktree（与 agents guard 同一套）。
  if [ "$MMW_D_WRITABLE" = "yes" ]; then
    MMW_D_CWD="$(mmw_require_writable_cwd "$MMW_D_CWD")" || return 1
    export MMW_D_CWD
  fi

  # shellcheck source=/dev/null
  . "$adapter"
  mmw_adapter_dispatch
}

usage_agents() {
  cat >&2 <<'EOF'
mmw agents materialize --host <pi|cursor|all> [--check] [--config <文件>] [--out <目录>]
    把 agent-src 与型号表物化成宿主原生 subagent 文件
Pi / Cursor：主 agent 直调原生 subagent，不经 mmw dispatch。
Claude Code：仍用 mmw dispatch。
EOF
  return 2
}

cmd_agents() {
  local sub="${1:-}"
  shift || true
  case "$sub" in
    materialize)
      local host=""
      local -a args=()
      while [ $# -gt 0 ]; do
        case "$1" in
          --host) host="${2:-}"; shift 2 ;;
          --check) args+=(--check); shift ;;
          --config)
            [ -n "${2:-}" ] || { echo "mmw: --config 要路径" >&2; usage_agents; }
            args+=(--config "$2"); shift 2
            ;;
          --out)
            [ -n "${2:-}" ] || { echo "mmw: --out 要目录" >&2; usage_agents; }
            args+=(--out "$2"); shift 2
            ;;
          *) echo "mmw: 认不出参数 $1" >&2; usage_agents ;;
        esac
      done
      [ -n "$host" ] || { echo "mmw: agents materialize 要 --host" >&2; usage_agents; }
      args+=(--host "$host")
      python3 "$MMW_ROOT/cli/lib/materialize_agents.py" "${args[@]}"
      ;;
    *) usage_agents ;;
  esac
}

usage_skills() {
  cat >&2 <<'EOF'
mmw skills materialize --host <pi|claude-code|codex|all> [--check] [--out <目录>]
    把 skills/ 源里的启动块与宿主动作块物化成宿主写死的操作
    pi → skills-pi/；claude-code → skills-claude-code/；codex → skills-codex/
EOF
  return 2
}

cmd_skills() {
  local sub="${1:-}"
  shift || true
  case "$sub" in
    materialize)
      local host=""
      local -a args=()
      while [ $# -gt 0 ]; do
        case "$1" in
          --host) host="${2:-}"; shift 2 ;;
          --check) args+=(--check); shift ;;
          --out)
            [ -n "${2:-}" ] || { echo "mmw: --out 要目录" >&2; usage_skills; }
            args+=(--out "$2"); shift 2
            ;;
          *) echo "mmw: 认不出参数 $1" >&2; usage_skills ;;
        esac
      done
      [ -n "$host" ] || { echo "mmw: skills materialize 要 --host" >&2; usage_skills; }
      args+=(--host "$host")
      python3 "$MMW_ROOT/cli/lib/materialize_skills.py" "${args[@]}"
      ;;
    *) usage_skills ;;
  esac
}

# 派出去的那一侧从哪个路径读方法论。宿主自己会送到位的，什么都不输出。
cmd_task() {
  local host
  host="$(mmw_host)" || return 1
  local sub="${1:-}"
  shift || true
  case "$sub" in
    state) [ $# -eq 0 ] || usage_task; mmw_task_state ;;
    bind) [ "$host" = "codex" ] || { echo "mmw: task bind 只用于 Codex App 已创建的 detached worktree" >&2; return 1; }; mmw_task_bind "$@" ;;
    new) [ "$host" != "codex" ] || { echo "mmw: Codex App 负责创建 worktree，这里只用 task bind" >&2; return 1; }; mmw_task_new "$@" ;;
    cleanup) [ "$host" != "codex" ] || { echo "mmw: Codex App 负责清理 managed worktree" >&2; return 1; }; mmw_task_cleanup "$@" ;;
    *) usage_task ;;
  esac
}

cmd_result() {
  local sub="${1:-}"
  shift || true
  case "$sub" in
    verify) mmw_result_verify "$@" ;;
    integrate) mmw_result_integrate "$@" ;;
    *) usage_result ;;
  esac
}

cmd_issue() {
  local sub="${1:-}"
  shift || true
  case "$sub" in
    create) mmw_issue_create "$@" ;;
    children) [ -n "${1:-}" ] || usage_issue; mmw_issue_children "$1" ;;
    claim) [ -n "${1:-}" ] || usage_issue; mmw_issue_claim "$1" ;;
    frontier)
      local parent="${1:-}" label="" label_prefix=""
      [ -n "$parent" ] || usage_issue
      shift
      while [ $# -gt 0 ]; do
        case "$1" in
          --label) label="${2:-}"; shift 2 ;;
          --label-prefix) label_prefix="${2:-}"; shift 2 ;;
          *) echo "mmw: issue frontier 认不出参数 $1" >&2; usage_issue ;;
        esac
      done
      if [ -n "$label" ] && [ -n "$label_prefix" ]; then
        echo "mmw: issue frontier 不能同时使用 --label 和 --label-prefix" >&2
        usage_issue
      fi
      mmw_issue_frontier "$parent" "$label" "$label_prefix"
      ;;
    link)
      local child="${1:-}" blocker=""
      [ -n "$child" ] || usage_issue
      shift
      while [ $# -gt 0 ]; do
        case "$1" in
          --blocked-by) blocker="${2:-}"; shift 2 ;;
          *) echo "mmw: issue link 认不出参数 $1" >&2; usage_issue ;;
        esac
      done
      [ -n "$blocker" ] || { echo "mmw: issue link 要 --blocked-by" >&2; usage_issue; }
      mmw_issue_link "$child" "$blocker"
      ;;
    *) usage_issue ;;
  esac
}

cmd_wiki() {
  local sub="${1:-}"
  shift || true
  case "$sub" in
    ensure) mmw_wiki_ensure ;;
    nav) mmw_wiki_nav ;;
    verify) [ -n "${1:-}" ] || usage_wiki; mmw_wiki_verify "$1" ;;
    *) usage_wiki ;;
  esac
}

cmd_domain() {
  local sub="${1:-}"
  shift || true
  [ $# -eq 0 ] || usage_domain
  case "$sub" in
    map-init) mmw_domain_map_init ;;
    sync) mmw_domain_sync ;;
    check) mmw_domain_check ;;
    adr-next) mmw_domain_adr_next ;;
