{
  "host": "cursor",
  "output": {
    "kind": "user-dir",
    "path": "~/.cursor/agents"
  },
  "managed_glob": "mmw-*.md",
  "provider_map": {},
  "model_format": "{id}[effort={effort}]",
  "frontmatter": {
    "name": "{agent}",
    "description": "{description}",
    "model": "{model}",
    "readonly": "{readonly}",
    "is_background": true
  }
}
