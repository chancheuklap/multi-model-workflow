{
  "host": "grok",
  "output": {
    "kind": "user-dir",
    "path": "~/.grok/agents"
  },
  "managed_glob": "mmw-*.md",
  "provider_map": {},
  "model_format": "{id}",
  "tools": {
    "writable": "",
    "readonly": ""
  },
  "frontmatter": {
    "name": "{agent}",
    "description": "{description}",
    "model": "{model}"
  },
  "companion": {
    "output": {
      "kind": "user-dir",
      "path": "~/.grok/roles"
    },
    "managed_glob": "mmw-*.toml",
    "suffix": ".toml",
    "template": [
      "description = {description}",
      "default_capability_mode = {capability_mode}",
      "reasoning_effort = {effort}"
    ]
  }
}
