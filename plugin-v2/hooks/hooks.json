{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/session-start.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/guard-premature-push.sh\""
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "pack-executor|complex-pack-executor",
        "hooks": [
          {
            "type": "command",
            "command": "echo '[multi-model-workflow] Coding agent completed. Next: dispatch codex:codex-rescue for independent review (pack review or targeted re-review per context).' >&2; exit 0"
          }
        ]
      },
      {
        "matcher": "codex:codex-rescue",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/track-review-budget.sh\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
