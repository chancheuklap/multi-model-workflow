{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/session-start.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/guard-premature-push.sh\""
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/cleanup-before-push.sh\""
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "pack-executor|complex-pack-executor",
        "hooks": [
          {
            "type": "command",
            "command": "echo '[multi-model-workflow] Coding agent completed. Next: read the review dispatch reference for this phase and follow the inline Codex review steps.' >&2; exit 0"
          }
        ]
      }
    ]
  }
}
