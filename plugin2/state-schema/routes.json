{
  "schema_version": "1",
  "description": "流程数据(不是散文)。只有一条主干流程;每种开口(preset)默认开主干里的哪几个阶段。'新设计'和'优化'是同一主干,只是默认开的前置不同——不再各列一张阶段清单。任务建好时把开着的阶段序列固化进进度记录的 phases;flow 据 phases 推进,升级/掉头就是改 phases。merge 不走主干、单列。",

  "conclusions": ["pass", "needs-repair", "needs-redirection", "needs-context", "blocked"],

  "caps": { "max_repair": 2, "max_turnaround": 1 },

  "spinoff_tags": ["bug", "optimize", "out-of-scope", "needs-evaluation"],

  "backbone": ["investigate", "propose", "design", "plan", "build", "verify", "closing"],

  "review_gates": ["design", "plan"],

  "start_options": [
    { "scenario": "small-change", "when": "明确的小改,根因清楚",                  "phases_note": "落地→验收→收尾" },
    { "scenario": "develop",      "when": "新想法/功能 或 旧系统优化改造(要设计)", "phases_note": "查清→给方案→想方案→拆计划→落地→验收→收尾" },
    { "scenario": "bug",          "when": "bug/报错/regression,根因不明",          "phases_note": "查清→落地(修)→验收→收尾" },
    { "scenario": "merge",        "when": "多个并行 worktree/PR 要合并",            "phases_note": "不开 worktree,走 references/scenario/merge.md" }
  ],

  "phase_bindings": {
    "investigate": { "load": "references/investigate.md",  "do": "并行投查现状(自建 Workflow),产出带引用的现状报告存 docs/investigating(取证不判定;不写 docs/context)", "produced": "docs/investigating/<slug>.md" },
    "propose":     { "load": "references/propose.md",      "do": "综合现状+外部,固定格式亮 2-3 方案,HITL 指定一个(或全否→needs-redirection 回上游)", "produced": "docs/design/<slug>-direction.md" },
    "design":      { "load": "references/design/design.md", "do": "拿已定方向产出设计文档(HITL 集中在此;不再提方案)",            "produced": ["docs/design/<slug>.md", "docs/issues/<slug>/"], "reads": ["investigate", "propose"] },
    "plan":        { "load": "references/plan/plan.md",     "do": "编排 + 派 plan-writer 拆计划(单计划则主线程内联)",            "produced": "docs/plans/<slug>/" },
    "build":       { "load": "references/build.md",        "do": "派 Codex 落地(各 plan 一 worktree)+ 你按计划验收",            "produced": "<提交范围,如 base..HEAD>" },
    "verify":      { "load": "references/review.md",       "do": "起 ④终审 loop(Codex 审 + 你按意图清单验)",                    "produced": "<终审报告路径>" },
    "closing":     { "load": "references/closing.md",      "do": "确认真完整、收口;合并/清理是合并后红线动作",                   "produced": "" },
    "review_gate": { "load": "references/review.md",       "do": "起该阶段审 loop(Codex 审者 + Claude 协调帮手),审完 handoff verdict", "produced": "" }
  },

  "presets": {
    "small-change": ["build", "verify", "closing"],
    "develop":      ["investigate", "propose", "design", "plan", "build", "verify", "closing"],
    "bug":          ["investigate", "build", "verify", "closing"]
  }
}
