#!/usr/bin/env python3
"""假构建机的 scp。真的搬文件，两个方向都支持。

上传：scp <本地> <host>:<远端路径>
下载：scp <host>:<远端路径> <本地>   —— 引擎回传构建日志走这个方向，回传不到要退非零，
      因为引擎靠退出码决定要不要打 WARN。
"""

from __future__ import annotations

import os
import re
import shutil
import sys
from pathlib import Path

ROOT = Path(os.environ["FAKE_REMOTE_ROOT"])


def local(remote_path: str) -> Path:
    p = remote_path.replace("\\", "/")
    p = re.sub(r"^[A-Za-z]:/", "", p)
    return ROOT / p.lstrip("/")


def split_remote(arg: str) -> str | None:
    """`host:C:/path` → `C:/path`。盘符里的冒号不能误判成 host 分隔符。"""
    m = re.match(r"^[^/:]+:(.*)$", arg)
    return m.group(1) if m else None


def main() -> int:
    args = [a for a in sys.argv[1:] if not a.startswith("-")]
    if len(args) < 2:
        return 1
    src, dst = args[0], args[1]

    dst_remote = split_remote(dst)
    if dst_remote is not None:
        target = local(dst_remote)
        target.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy(src, target)
        return 0

    src_remote = split_remote(src)
    if src_remote is not None:
        source = local(src_remote)
        if not source.is_file():
            return 1
        shutil.copy(source, dst)
        return 0

    shutil.copy(src, dst)
    return 0


if __name__ == "__main__":
    sys.exit(main())
