#!/usr/bin/env bash
# 提交前的门禁：对这次要提交的文件跑一遍检查器，问题落在改动行上就拦下来。
#
# 补的是编辑后诊断够不到的那一块。那一层挂在 agent 的编辑工具上，靠工具载荷里的
# 文件路径触发。用 shell 改的（`cat >>`、`sed -i`）拿不到路径，你自己在编辑器里改的、
# 别的电脑改的更拿不到——这些全都不在覆盖范围里，而漏检跟代码干净长得一模一样。
# 挂在提交上就跟改法无关了：不管谁怎么改的，进历史之前都要过这一关。
#
# 装法是全局 `core.hooksPath`，一处设置覆盖这台机器上所有仓库，不用一个个装。
# 代价是它会把每个仓库自己的 `.git/hooks` 整个盖掉，所以本脚本第一件事就是把仓库
# 自己那份 pre-commit 接回来先跑。用 husky 的仓库不受影响：husky 在仓库级设
# `core.hooksPath`，而仓库级压过全局。
#
# 边界，先说清楚：检的是**工作区**的内容，按「相对 HEAD 改过的行」过滤。只
# `git add` 了一部分时这两者不一致，会多报没暂存的那几行。多报不会漏掉真问题，
# 方向是安全的；要做到精确得把索引检出到临时目录再检，那是另一件事。

set -uo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
CHECK="$HERE/../check.py"

# 仓库自己那份 pre-commit 先跑，它说不行就不用往下走了。
#
# 用 --git-dir 拼路径，不用 `git rev-parse --git-path hooks/pre-commit`：后者认
# core.hooksPath，会解析回本脚本，于是自己调自己。
git_dir="$(git rev-parse --git-dir 2>/dev/null || true)"
if [ -n "$git_dir" ] && [ -x "$git_dir/hooks/pre-commit" ]; then
  "$git_dir/hooks/pre-commit" "$@" || exit $?
fi

root="$(git rev-parse --show-toplevel 2>/dev/null || true)"
[ -n "$root" ] || exit 0
[ -f "$CHECK" ] || exit 0
command -v python3 >/dev/null 2>&1 || exit 0

# 这次要提交哪些文件。D 不要：删掉的文件没什么可检的。
# 不用 mapfile：macOS 自带的是 bash 3.2，没有这个内建。
files=()
while IFS= read -r line; do
  [ -n "$line" ] && files+=("$root/$line")
done < <(git diff --cached --name-only --diff-filter=ACMR 2>/dev/null)

[ "${#files[@]}" -gt 0 ] || exit 0

python3 "$CHECK" --repo "$root" --changed-only "${files[@]}" && exit 0

{
  echo
  echo "提交被拦下：上面这些问题落在这次改动的行上。修好再提交。"
  echo "既有问题不算在内，只算这次引入的。"
} >&2
exit 1
