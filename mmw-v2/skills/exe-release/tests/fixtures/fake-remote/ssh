#!/usr/bin/env python3
"""假构建机的 ssh。不记录命令文本，真的执行远端语义。

为什么要它：远端交互没法在 Mac 上真跑（schtasks 是 Windows 独有的），但把 ssh 换成
「把命令行追加进一个文件」再 grep 那个文件，测的就成了「引擎说了什么」而不是「构建机
上发生了什么」——引擎把任务名拼错、create 和 delete 用了两个不同的名字，只要都能匹配
同一个 grep 模式就照样绿。

这里改成维护两样真状态：一棵本地目录树当远端文件系统，一份任务登记表当 Task Scheduler。
测试断的是这两样的最终状态。任务名拼错就删不掉，登记表里会留下残骸，断言自然红。

环境变量：
  FAKE_REMOTE_ROOT     本地目录，代表远端文件系统根
  FAKE_REMOTE_TASKS    任务登记表 JSON
  FAKE_BUILD_OUTCOME   schtasks /run 之后构建产出什么：
                         success      exitcode=0
                         fail:<code>  exitcode=<code>
                         hang         什么都不产出（模拟构建卡死）
                         garbage      exitcode 写成非数字
  FAKE_RUN_FAILS       非空则 schtasks /run 退非零（模拟启动不起来）
  FAKE_REMOVE_FAILS    非空则 Remove-Item 退非零（模拟清不掉旧产物）
"""

from __future__ import annotations

import json
import os
import re
import shutil
import sys
import zipfile
from pathlib import Path

ROOT = Path(os.environ["FAKE_REMOTE_ROOT"])
TASKS = Path(os.environ["FAKE_REMOTE_TASKS"])


def local(remote_path: str) -> Path:
    """把远端路径映射到本地目录树。C:/x/y 与 C:\\x\\y 都落到 ROOT/x/y。"""
    p = remote_path.strip().strip("'\"").replace("\\", "/")
    p = re.sub(r"^[A-Za-z]:/", "", p)
    return ROOT / p.lstrip("/")


def load_tasks() -> dict:
    if TASKS.is_file():
        return json.loads(TASKS.read_text(encoding="utf-8"))
    return {}


def save_tasks(d: dict) -> None:
    TASKS.parent.mkdir(parents=True, exist_ok=True)
    TASKS.write_text(json.dumps(d, ensure_ascii=False), encoding="utf-8")


def quoted(cmd: str) -> list[str]:
    return re.findall(r"'([^']*)'", cmd)


def do_powershell(cmd: str) -> int:
    """按引擎真正发出的那几条 PowerShell 命令做事。顺序跟引擎里的一致。"""
    if "New-Item" in cmd:
        for path in quoted(cmd):
            local(path).mkdir(parents=True, exist_ok=True)
        return 0

    if "Expand-Archive" in cmd:
        # 引擎这一条是三段：先删旧 source，再解压，再验非空。
        paths = quoted(cmd)
        if len(paths) < 3:
            return 1
        old, archive, dest = local(paths[0]), local(paths[1]), local(paths[2])
        shutil.rmtree(old, ignore_errors=True)
        if not archive.is_file():
            return 1
        dest.mkdir(parents=True, exist_ok=True)
        with zipfile.ZipFile(archive) as z:
            z.extractall(dest)
        if not any(dest.iterdir()):
            return 1
        # 引擎这一条的最后一段:解压成功之后把 zip 删掉。zip 是源码的第二份副本,
        # 一份几百 MB,留着就是每一次尝试在构建机上多占一份。
        # 按最后一段解析而不是按第 N 个引号取:中间那个 if 自己就带着两个引号路径。
        tail = cmd.rsplit(";", 1)[-1].strip()
        if tail.startswith("Remove-Item"):
            for path in quoted(tail):
                local(path).unlink(missing_ok=True)
        return 0

    if cmd.strip().startswith("Get-ChildItem") and "Select-Object -Skip" in cmd:
        # 上一轮失败的构建目录只留最近几个。真的按 mtime 排序再删,不是「命令里出现了
        # Remove-Item 就算数」——留几个、留哪几个,错了就是把现场删掉或者一个都没删。
        import fnmatch

        paths = quoted(cmd)
        if len(paths) < 3:
            return 1
        root, like, exclude = local(paths[0]), paths[1], paths[2]
        skip = int(re.search(r"-Skip\s+(\d+)", cmd).group(1))
        kept = [
            d for d in root.iterdir()
            if d.is_dir() and fnmatch.fnmatch(d.name, like) and d.name != exclude
        ]
        kept.sort(key=lambda d: d.stat().st_mtime, reverse=True)
        for d in kept[skip:]:
            shutil.rmtree(d, ignore_errors=True)
        return 0

    if "Remove-Item" in cmd:
        if os.environ.get("FAKE_REMOVE_FAILS"):
            return 1
        for path in quoted(cmd):
            target = local(path)
            if target.is_dir():
                shutil.rmtree(target, ignore_errors=True)
            else:
                target.unlink(missing_ok=True)
        # 引擎这一条自带「删完还在就退 1」的自检，如实照做。
        if "Test-Path" in cmd and any(local(p).exists() for p in quoted(cmd)):
            return 1
        return 0

    if cmd.strip().startswith("Get-Content") or "Get-Content" in cmd:
        paths = quoted(cmd)
        if paths and local(paths[0]).is_file():
            sys.stdout.write(local(paths[0]).read_text(encoding="utf-8"))
            return 0
        return 1

    if "Test-Path" in cmd:
        print("Y" if any(local(p).exists() for p in quoted(cmd)) else "N")
        return 0

    if "schtasks" in cmd:
        # 清理走的是 `schtasks /end ...; schtasks /delete ...`，分号顺序执行。
        rc = 0
        for part in cmd.split(";"):
            if part.strip():
                rc = do_schtasks(part.strip().split()) or rc
        return rc

    if "deliver-installer.ps1" in cmd:
        # 真的收拢:引擎按 DELIVERED 行判断安装包到底有没有落到交付目录,而那一行的有无
        # 又决定它敢不敢删掉远端构建目录。这里回一句空话,测的就成了「引擎说了什么」。
        paths = quoted(cmd)
        if len(paths) < 3:
            return 1
        dest, src_glob = local(paths[1]), local(paths[2])
        hits = [
            f for f in sorted(src_glob.parent.glob(src_glob.name))
            if f.is_file() and f.suffix == ".exe" and "__" not in f.name
        ]
        if not hits:
            return 3
        dest.mkdir(parents=True, exist_ok=True)
        for hit in hits:
            shutil.copy2(hit, dest / hit.name)
            print(f"DELIVERED {dest / hit.name}")
        return 0

    return 0


def do_schtasks(argv: list[str]) -> int:
    tasks = load_tasks()
    flags = {}
    i = 0
    while i < len(argv):
        if argv[i].startswith("/") and i + 1 < len(argv) and not argv[i + 1].startswith("/"):
            flags[argv[i].lower()] = argv[i + 1]
            i += 2
        else:
            flags[argv[i].lower()] = True
            i += 1

    name = flags.get("/tn")
    if not isinstance(name, str):
        return 1

    if "/create" in flags:
        tasks[name] = {"cmd": flags.get("/tr"), "state": "ready"}
        save_tasks(tasks)
        # 登记表反映的是此刻还挂着什么，构建结束会被清空。要断「构建机收到过一条什么样
        # 的任务」得另留一份历史，否则只能在任务还活着的那一瞬间去看它。
        with (TASKS.parent / (TASKS.name + ".history")).open("a", encoding="utf-8") as fh:
            fh.write(json.dumps({"name": name, "cmd": flags.get("/tr")}, ensure_ascii=False) + "\n")
        return 0

    if "/run" in flags:
        if os.environ.get("FAKE_RUN_FAILS"):
            return 1
        if name not in tasks:
            return 1
        tasks[name]["state"] = "running"
        save_tasks(tasks)
        produce_build_output()
        return 0

    if "/end" in flags:
        if name in tasks:
            tasks[name]["state"] = "ended"
            save_tasks(tasks)
        return 0

    if "/delete" in flags:
        if name in tasks:
            del tasks[name]
            save_tasks(tasks)
            return 0
        # 引擎起手先删同名残留，那时本来就没有；这跟真 schtasks 一样退非零。
        return 1

    return 0


def produce_build_output() -> None:
    """模拟构建任务真的跑起来之后在远端留下的产物。"""
    outcome = os.environ.get("FAKE_BUILD_OUTCOME", "success")
    if outcome == "hang":
        return
    inputs = [d for d in ROOT.rglob("run-release.ps1")]
    if not inputs:
        return
    build_dir = inputs[0].parent
    (build_dir / "build-run.log").write_text("fake build log\n", encoding="utf-8")
    if outcome == "success":
        # 真实构建把安装包产在源码树里,交付步骤再从那里收拢。没有这一份,交付永远空跑。
        out = build_dir / "source" / "out"
        out.mkdir(parents=True, exist_ok=True)
        (out / "test-product-setup.exe").write_text("fake installer\n", encoding="utf-8")
    if outcome == "garbage":
        (build_dir / "build-run.exitcode").write_text("garbage\n", encoding="utf-8")
    elif outcome.startswith("fail:"):
        (build_dir / "build-run.exitcode").write_text(outcome.split(":", 1)[1] + "\n", encoding="utf-8")
    else:
        (build_dir / "build-run.exitcode").write_text("0\n", encoding="utf-8")


def main() -> int:
    # argv: [ssh, host, command...]
    cmd = " ".join(sys.argv[2:])
    ROOT.mkdir(parents=True, exist_ok=True)

    m = re.match(r'^powershell\s+.*?-Command\s+"(.*)"\s*$', cmd, re.S)
    if m:
        return do_powershell(m.group(1))
    if cmd.strip().startswith("powershell"):
        return do_powershell(cmd)
    if cmd.strip().startswith("schtasks"):
        return do_schtasks(cmd.strip().split())
    return 0


if __name__ == "__main__":
    sys.exit(main())
