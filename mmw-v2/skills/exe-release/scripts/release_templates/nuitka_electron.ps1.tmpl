param(
  [string]$ReleaseContextPath = ${CONTEXT_DEFAULT_PATH}
)

Set-StrictMode -Version Latest
$ErrorActionPreference = 'Stop'

# PowerShell writes its own errors in the machine's display language, and a Chinese Windows build
# machine then hands back a GBK-encoded sentence that arrives on the driving side as mojibake --
# the one line naming the file and column where the build stopped. Pin this script's UI language so
# every word in the log is English, whatever language the machine was installed in.
try {
  [Threading.Thread]::CurrentThread.CurrentUICulture = [Globalization.CultureInfo]::new('en-US')
} catch { }

function Step {
  param([string]$Label)
  Write-Host $Label
}

function Assert-Tool {
  param([string]$Name)
  if (-not (Get-Command $Name -ErrorAction SilentlyContinue)) {
    throw "Required build tool is unavailable: $Name"
  }
}

function Invoke-Checked {
  param([string]$Command, [string[]]$Arguments, [string]$WorkingDirectory)
  Push-Location $WorkingDirectory
  try {
    & $Command @Arguments
    if ($LASTEXITCODE -ne 0) {
      throw "Build command failed: $Command ($LASTEXITCODE)"
    }
  }
  finally { Pop-Location }
}

# Only the build machine knows where a native extension's missing DLL really is.
#
# compile_interpreter: must come from *the interpreter that runs Nuitka*. The python3.dll an abi3
#   extension links is a forwarder; a version mismatch forwards to a pythonNNN.dll that does not
#   exist, and the customer machine gets a bare ImportError.
# system32: the MSVC C++ runtime, version independent, taken from its official location so the
#   package is self-contained on customer machines (no VC++ install needed).
#
# Missing means stop here. Letting it slip through costs a crash once the customer reaches that
# feature, and by then the product has shipped.
function Resolve-BuildDll {
  param([string]$Source, [string]$Name, [string[]]$RunnerArgv, [string]$WorkingDirectory)
  if ($Source -eq 'system32') {
    $root = if ($env:SystemRoot) { $env:SystemRoot } else { 'C:\Windows' }
    $candidate = Join-Path (Join-Path $root 'System32') $Name
    if (-not (Test-Path -LiteralPath $candidate)) {
      throw "Build machine is missing $Name at $candidate; the native extension that links it would fail on customer machines"
    }
    return $candidate
  }
  if ($Source -ne 'compile_interpreter') {
    throw "Unknown native extension DLL source: $Source"
  }
  Push-Location $WorkingDirectory
  try {
    $command = [string]$RunnerArgv[0]
    $arguments = @()
    if ($RunnerArgv.Count -gt 1) { $arguments += @($RunnerArgv[1..($RunnerArgv.Count - 1)]) }
    $arguments += @('-c', 'import sys; print(sys.base_prefix)')
    $basePrefix = (& $command @arguments | Select-Object -Last 1)
    if ($LASTEXITCODE -ne 0) { throw "Cannot resolve the compile interpreter base_prefix ($LASTEXITCODE)" }
  }
  finally { Pop-Location }
  $basePrefix = "$basePrefix".Trim()
  foreach ($dir in @($basePrefix, (Join-Path $basePrefix 'DLLs'))) {
    $candidate = Join-Path $dir $Name
    if (Test-Path -LiteralPath $candidate) { return $candidate }
  }
  throw "The compile interpreter at $basePrefix is missing $Name; an abi3 native extension needs it, and without it the packaged app fails to import that extension"
}

# Run one import in the compiled exe, in place. A frozen build missing a dynamic dependency shows
# up only when it really runs; surfacing that on the build machine is orders of magnitude cheaper
# than a crash after the customer installs. A timeout counts as failure: a hung smoke test passes
# no more than a failed one.
function Invoke-BuiltExeSmoke {
  param([string]$Exe, [string[]]$Arguments, [int]$TimeoutSeconds)
  if (-not (Test-Path -LiteralPath $Exe)) {
    throw "Compiled backend is missing, cannot run the import smoke: $Exe"
  }
  $process = Start-Process -FilePath $Exe -ArgumentList $Arguments `
    -WorkingDirectory (Split-Path -Parent $Exe) -NoNewWindow -PassThru
  # Touch Handle once before the process exits. The object Start-Process -PassThru returns holds no
  # handle, so .NET releases it the moment the process ends and ExitCode can never be read again.
  # In PowerShell $null -ne 0 is *true*, so "could not read the exit code" reads as "smoke failed":
  # the check can then never pass, while the line above it in the log says it did. Touching the
  # handle once makes .NET keep the exit code for us.
  $null = $process.Handle
  if (-not $process.WaitForExit($TimeoutSeconds * 1000)) {
    try { $process.Kill() } catch { }
    throw "Compiled backend import smoke timed out after $($TimeoutSeconds)s (an import likely started a thread that never exits)"
  }
  # Wait once more with no argument after the timed wait returns: this settles both the exit code
  # and the output streams.
  $process.WaitForExit()
  $exitCode = $process.ExitCode
  if ($null -eq $exitCode) {
    throw "Compiled backend import smoke ran but its exit code could not be read; treat this as a build harness fault, not a missing dependency"
  }
  if ($exitCode -ne 0) {
    throw "Compiled backend import smoke failed ($exitCode); the frozen build is missing a dynamic dependency. Fix the Nuitka include flags in the release adapter key and rebuild."
  }
}

# Move the named directories aside for the compile, then move them back unchanged.
#
# When Electron's node_modules is hoisted under a path Python scans for packages, Nuitka walks it:
# compile time explodes, and frontend files can land in the package. A failed move-back must stop
# the build: leaving a working tree without node_modules makes the Electron build right after it
# fail in a way whose root cause is invisible.
function Move-AsideForCompile {
  param([string[]]$Paths, [string]$Holding)
  $moved = @()
  foreach ($path in $Paths) {
    if (-not (Test-Path -LiteralPath $path)) { continue }
    $target = Join-Path $Holding ([System.IO.Path]::GetRandomFileName())
    New-Item -ItemType Directory -Force -Path $Holding | Out-Null
    Move-Item -LiteralPath $path -Destination $target
    Write-Host "  moved aside for the compile: $path"
    $moved += ,@($path, $target)
  }
  return ,$moved
}

function Restore-AfterCompile {
  param($Moved)
  foreach ($pair in $Moved) {
    $path = $pair[0]
    $target = $pair[1]
    if (Test-Path -LiteralPath $path) {
      throw "Cannot restore $path after the compile: something else already created it"
    }
    Move-Item -LiteralPath $target -Destination $path
    Write-Host "  restored after the compile: $path"
  }
}

# The package must carry no business source.
#
# Shipping no source is the whole point of compiling; ship it and the product's commercial premise
# is gone. Unlike a crash, this never announces itself: the package installs, it works, and the
# source just sits inside where nobody looks. So this is not a check a product opts into, it is
# something the skill does every time, and the key says nothing about it: the business package
# names are python_backend.include_packages, which the key already holds.
#
# Only business packages are checked. Third-party packages in an embedded runtime legitimately
# carry .py files, and reporting those too is the same as reporting nothing.
function Assert-NoBusinessSource {
  param([string[]]$Roots, [string[]]$SourceRoots)
  # "This product's own code" is compared as an import path, not as a path suffix.
  #
  # A .py file's import path is what Python would call it: walk up from the file while each
  # directory above it is a package, and stop at the first one that is not. So
  # site-packages/openai/types/shared/__init__.py is openai.types.shared, and src/shared/__init__.py
  # is shared. Different modules, no match.
  #
  # Comparing by name, and then by path suffix, each blocked a real release that had nothing wrong
  # with it. A key's include_packages mixes in third-party names, and source trees hold directories
  # as ordinary as shared / api / types -- so a third-party file deep inside an embedded runtime kept
  # colliding with a repository package of the same name. An import path cannot collide that way:
  # it is anchored at the top-level package, not at any tail.
  function Get-ImportPath {
    param([IO.FileInfo]$File)
    $parts = @($File.Name)
    $dir = $File.Directory
    while ($dir -and (Test-Path -LiteralPath (Join-Path $dir.FullName '__init__.py'))) {
      $parts = @($dir.Name) + $parts
      $dir = $dir.Parent
    }
    return ($parts -join '/').ToLowerInvariant()
  }

  $repoModules = New-Object 'System.Collections.Generic.HashSet[string]'
  foreach ($sourceRoot in $SourceRoots) {
    $full = Join-Path $RepoRoot $sourceRoot
    if (-not (Test-Path -LiteralPath $full)) { continue }
    $base = (Resolve-Path -LiteralPath $full).Path
    foreach ($file in @(Get-ChildItem -LiteralPath $base -Recurse -File -Filter *.py -ErrorAction SilentlyContinue)) {
      [void]$repoModules.Add((Get-ImportPath -File $file))
    }
  }
  if ($repoModules.Count -eq 0) {
    throw "Source roots named by the key hold no Python to protect: $($SourceRoots -join ', ')"
  }
  $found = @()
  foreach ($root in $Roots) {
    if (-not (Test-Path -LiteralPath $root)) { continue }
    $prefix = (Resolve-Path -LiteralPath $root).Path
    foreach ($file in @(Get-ChildItem -LiteralPath $prefix -Recurse -File -Filter *.py -ErrorAction SilentlyContinue)) {
      if ($repoModules.Contains((Get-ImportPath -File $file))) { $found += $file.FullName }
    }
  }
  if ($found.Count -gt 0) {
    throw "Business Python source shipped in the package: $($found -join '; ')"
  }
  Write-Host "  no business source in the shipped tree ($($repoModules.Count) repo modules checked)"
}

# A third-party binary the package ships but the repository cannot hold: too large for git, so it
# lives on the build machine and is copied in, then checked against the hashes the repository does
# hold. No download: upstream retention is not ours to control, and the address one product locked
# has already gone dead -- the release branch it named was dropped from the upstream tag entirely.
# A file on a machine we own does not rot; a link does.
#
# The hash check is the whole difference between "a file" and "the right file". A build of the same
# tool from a different source can be wrong in a way nothing reports: it runs, it encodes, and on a
# customer machine whose driver is too old for it, it falls back to software encoding and takes many
# times longer. So a mismatch stops the release rather than warning.
#
# Where the files live is a convention, not a key field: <cache_root>/vendor/<name>/. Keys hold no
# absolute paths -- they are written on one machine and run on another.
function Get-VendorArtifact {
  param(
    [string]$Name,
    [string]$LockPath,
    [object[]]$Members,
    [string]$CacheRoot,
    [string]$RepoRoot
  )
  if (-not (Test-Path -LiteralPath $LockPath)) {
    throw "The vendor artifact lock is missing: $LockPath ($Name)"
  }
  $lock = Get-Content -LiteralPath $LockPath -Raw -Encoding UTF8 | ConvertFrom-Json
  $sourceDir = if ($CacheRoot) { Join-Path $CacheRoot ("vendor\" + $Name) } else { "" }
  if (-not $sourceDir) {
    throw "This build has no cache root, so there is nowhere for the $Name files to live"
  }

  foreach ($member in $Members) {
    $file = [string]$member.File
    $expected = [string]$lock.($member.Sha256Key)
    if (-not $expected) { throw "The lock records no $($member.Sha256Key) : $LockPath ($Name)" }
    $expected = $expected.ToLowerInvariant()
    $dest = Join-Path $RepoRoot ([string]$member.Dest)

    if ((Test-Path -LiteralPath $dest) -and
        (Get-FileHash -LiteralPath $dest -Algorithm SHA256).Hash.ToLowerInvariant() -eq $expected) {
      Write-Host ("  vendor " + $Name + ": " + $file + " already in place")
      continue
    }
    $source = Join-Path $sourceDir $file
    if (-not (Test-Path -LiteralPath $source)) {
      throw ("This build machine has no " + $file + " for " + $Name + ". Put it in " + $sourceDir +
             " (the hash it must have is " + $($member.Sha256Key) + " in " + $LockPath + ")")
    }
    New-Item -ItemType Directory -Force -Path (Split-Path -Parent $dest) | Out-Null
    Copy-Item -LiteralPath $source -Destination $dest -Force
    $actual = (Get-FileHash -LiteralPath $dest -Algorithm SHA256).Hash.ToLowerInvariant()
    if ($actual -ne $expected) {
      Remove-Item -LiteralPath $dest -Force -ErrorAction SilentlyContinue
      throw ("Vendor artifact " + $Name + " does not match the lock: " + $file +
             " expected " + $expected + ", got " + $actual + " (from " + $source + ")")
    }
    Write-Host ("  vendor " + $Name + ": " + $file + " copied and verified")
  }
}

# A copyleft binary travels with its licence, and the licence travels inside the package -- not in
# the repository where the build staged it. Between the two sits a packaging filter, and when that
# filter drops the licence the build stays green and the shipped installer is in breach.
#
# The gate holds no path inside the package: where the packaging config puts a staged file is the
# packaging config's business. It takes the bytes of the staged file and asks whether any file in
# the package has them. Size first, hash only for the files that could match, so the scan stays
# cheap on a tree of many gigabytes.
function Assert-LicensesShipped {
  param(
    [object[]]$Licenses,
    [string]$RepoRoot,
    [string]$PackageDir
  )
  if (-not $Licenses -or $Licenses.Count -eq 0) { return }
  # The package tree can carry the version in its name, so this may be a wildcard. One tree, or
  # the gate does not know which one it just checked.
  $roots = @(Resolve-Path -Path $PackageDir -ErrorAction SilentlyContinue | ForEach-Object { $_.Path })
  if ($roots.Count -ne 1) {
    throw ("There is no single package to look for the licences in: " + $PackageDir +
           " matched " + $roots.Count + " paths")
  }
  $PackageDir = $roots[0]
  $packaged = @(Get-ChildItem -LiteralPath $PackageDir -Recurse -File -Force -ErrorAction SilentlyContinue)
  foreach ($licence in $Licenses) {
    $name = [string]$licence.Name
    $staged = Join-Path $RepoRoot ([string]$licence.Path)
    if (-not (Test-Path -LiteralPath $staged)) {
      throw ("The licence " + $name + " needs is not in the tree: " + $staged)
    }
    $size = (Get-Item -LiteralPath $staged).Length
    $expected = (Get-FileHash -LiteralPath $staged -Algorithm SHA256).Hash.ToLowerInvariant()
    $hit = $null
    foreach ($candidate in @($packaged | Where-Object { $_.Length -eq $size })) {
      if ((Get-FileHash -LiteralPath $candidate.FullName -Algorithm SHA256).Hash.ToLowerInvariant() -eq $expected) {
        $hit = $candidate
        break
      }
    }
    if (-not $hit) {
      throw ("The package ships " + $name + " without " + [string]$licence.Path +
             ". Those bytes reach no file under " + $PackageDir +
             ", so the packaging config filters them out")
    }
    Write-Host ("  licence shipped: " + $name + " -> " + $hit.FullName)
  }
}


# Every onefile exe must carry the payload that was built for it, in this round.
#
# A onefile exe is a small bootstrap with the whole program appended to it as a payload. How that
# payload reaches the exe is the compiler's business, and it has gone wrong in a way no build log
# shows: with Nuitka's default under zig the payload arrives through a C file that names it with
# C23 #embed, no compiler cache hashes a file pulled in that way, and the second target of a run
# gets handed the first one's object. Two exes, byte-identical, both running the first program,
# every step green. The skill now asks Nuitka for a payload route that never touches a compiler,
# but that is a setting, and a setting can be overridden, a default can change, a toolchain can be
# swapped. This check does not care which route was taken or which cache was involved: it reads
# what is actually inside the exe.
#
# Nothing here is named or matched by convention. Each payload is claimed by exactly one exe, and
# an exe that claims a payload another exe already claimed is the failure we are looking for.
# The compiler's leftovers do not go to the customer.
#
# Nuitka writes three scratch directories next to the finished exe: <entry>.build (the C it
# generated from the product's own source, plus the scons debug files), <entry>.dist (the
# standalone tree) and <entry>.onefile-build (holding blobs\__payload.bin). All three sit in the
# directory the packer copies wholesale into the installer -- so the same content ships three
# times over: once inside the exe, once as the dist tree, once as the raw payload. And .build is
# worse than bloat, because compiling exists to not ship source.
#
# This runs after the payload check, which is the one step that needs those directories.
function Remove-CompilerIntermediates {
  param([string]$OutputDir)
  if (-not (Test-Path -LiteralPath $OutputDir)) { return }
  $leftovers = @(
    Get-ChildItem -LiteralPath $OutputDir -Directory -ErrorAction SilentlyContinue |
      Where-Object {
        $_.Name -like '*.build' -or $_.Name -like '*.dist' -or $_.Name -like '*.onefile-build'
      }
  )
  if ($leftovers.Count -eq 0) {
    Write-Host '  compiler intermediates: none left behind'
    return
  }
  foreach ($dir in $leftovers) {
    $bytes = (Get-ChildItem -LiteralPath $dir.FullName -Recurse -File -Force -ErrorAction SilentlyContinue |
      Measure-Object -Sum Length).Sum
    Remove-Item -LiteralPath $dir.FullName -Recurse -Force
    Write-Host ("  removed compiler intermediate: " + $dir.Name + "  " + [math]::Round($bytes / 1MB, 1) + " MB")
  }
}

function Assert-DistinctExeTails {
  param([string[]]$Exes)
  $seen = @{}
  $sha = [Security.Cryptography.SHA256]::Create()
  try {
    foreach ($exe in $Exes) {
      if (-not (Test-Path -LiteralPath $exe)) { throw "A compiled exe the key asked for is missing: $exe" }
      $stream = [IO.File]::OpenRead($exe)
      try {
        $size = [int][math]::Min(1MB, $stream.Length)
        if ($size -lt 8192) { throw "A compiled exe is implausibly small: $exe ($($stream.Length) bytes)" }
        $null = $stream.Seek(-$size, [IO.SeekOrigin]::End)
        $buffer = New-Object byte[] $size
        $offset = 0
        while ($offset -lt $size) {
          $read = $stream.Read($buffer, $offset, $size - $offset)
          if ($read -le 0) { throw "Could not read the tail of $exe" }
          $offset += $read
        }
      } finally { $stream.Dispose() }
      $tail = [BitConverter]::ToString($sha.ComputeHash($buffer))
      if ($seen.ContainsKey($tail)) {
        throw ("Onefile payload mismatch: $exe ends with the same bytes as $($seen[$tail]) " +
               "-- one of them is the wrong program")
      }
      $seen[$tail] = $exe
      Write-Host ("  payload tail verified: " + (Split-Path -Leaf $exe))
    }
  } finally { $sha.Dispose() }
}

function Assert-OnefilePayloads {
  param([string]$OutputDir, [string[]]$Exes)
  if (-not (Test-Path -LiteralPath $OutputDir)) {
    throw "The compiler wrote no output directory: $OutputDir"
  }
  $payloads = @(
    Get-ChildItem -LiteralPath $OutputDir -Directory -Filter '*.onefile-build' -ErrorAction SilentlyContinue |
      ForEach-Object { Join-Path $_.FullName 'blobs\__payload.bin' } |
      Where-Object { Test-Path -LiteralPath $_ }
  )
  if ($payloads.Count -eq 0) {
    if ($Exes.Count -lt 2) {
      Write-Host '  onefile payloads: none kept, and a single exe cannot collide with itself'
      return
    }
    # --remove-output deletes the payload directories, and without them the check above has
    # nothing to read. The collision is still visible in the exes: Nuitka appends the payload,
    # so two exes carrying the same one end with the same bytes.
    Assert-DistinctExeTails -Exes $Exes
    return
  }
  # Latin1 maps every byte to one char, so a byte search becomes a native string search. Reading
  # the exe any other way would mean a per-byte loop over fifty megabytes in PowerShell.
  $latin1 = [Text.Encoding]::GetEncoding(28591)
  $probes = @{}
  foreach ($payload in $payloads) {
    $bytes = [IO.File]::ReadAllBytes($payload)
    if ($bytes.Length -lt 8192) { throw "A onefile payload is implausibly small: $payload ($($bytes.Length) bytes)" }
    # Probe from the middle: a header two payloads could share proves nothing.
    $offset = [int]($bytes.Length / 2)
    $probes[$payload] = $latin1.GetString($bytes[$offset..($offset + 255)])
  }
  $claimedBy = @{}
  foreach ($exe in $Exes) {
    if (-not (Test-Path -LiteralPath $exe)) { throw "A compiled exe the key asked for is missing: $exe" }
    $haystack = $latin1.GetString([IO.File]::ReadAllBytes($exe))
    $hits = @($payloads | Where-Object { $haystack.IndexOf($probes[$_], [StringComparison]::Ordinal) -ge 0 })
    if ($hits.Count -eq 0) {
      throw "Onefile payload mismatch: $exe carries none of the payloads this build produced"
    }
    if ($hits.Count -gt 1) {
      throw "Onefile payload mismatch: $exe carries more than one payload ($($hits -join '; '))"
    }
    $payload = $hits[0]
    if ($claimedBy.ContainsKey($payload)) {
      throw ("Onefile payload mismatch: $exe carries the same payload as $($claimedBy[$payload]) " +
             "-- one of them is the wrong program (payload: $payload)")
    }
    $claimedBy[$payload] = $exe
    Write-Host ("  payload verified: " + (Split-Path -Leaf $exe))
  }
}

# An installer really exists, and it is where the key says it will be.
#
# The installer step exiting 0 does not mean an installer exists: the packaging tool failing to
# clean up a temp file, or a hook that only got halfway, both leave the step "successful" with an
# empty directory. The next one to find out is the customer.
function Assert-InstallerProduced {
  param([string]$Glob)
  $items = @(Get-ChildItem -Path $Glob -File -ErrorAction SilentlyContinue)
  if ($items.Count -eq 0) {
    throw "No installer matched the key's installer_glob: $Glob"
  }
  foreach ($item in $items) {
    Write-Host ("  installer: " + $item.FullName + "  " + [math]::Round($item.Length / 1MB, 1) + " MB")
  }
}

# Prepare the build machine before the long compile starts. Every line below was bought with one
# "a package took all day" or one "it blew up deep into the compile", and every product needs the
# same ones, which is why they live in the skill and in no product repo.
# Facts about this machine (mirror URLs, where ccache is installed) come through build_env in
# remote-build.json; facts about the product (offline wheels, its own cache dirs) come through the
# key's build_machine.setup hook.
$Script:DefenderExclusions = @()

function Initialize-BuildMachine {
  param([string]$RepoRoot, [object]$BuildEnv, [string]$CacheRoot)

  # Apply the build machine's own facts first: mirror URLs, the exact ccache path, the things only
  # this machine knows.
  if ($BuildEnv) {
    foreach ($item in $BuildEnv.PSObject.Properties) {
      [Environment]::SetEnvironmentVariable($item.Name, [string]$item.Value)
      Write-Host ("  build env: " + $item.Name)
    }
  }

  # A Chinese Windows build machine decodes child output as GBK (cp936), while repo hooks are
  # Python and write UTF-8. Decoded as GBK that is a screenful of mojibake, and nobody can read why
  # the release failed. Pin both ends to UTF-8: Python writes it, the console reads it.
  $env:PYTHONIOENCODING = 'utf-8'
  try {
    [Console]::OutputEncoding = [Text.UTF8Encoding]::new($false)
    $OutputEncoding = [Text.UTF8Encoding]::new($false)
  } catch { Write-Host ("  utf-8 console skip: " + $_.Exception.Message) }

  # uv hardlinks packages into the environment by default. The build directory and the cache are
  # often on different volumes, and a failed hardlink degrades into downloading again and again.
  if (-not $env:UV_LINK_MODE) { $env:UV_LINK_MODE = 'copy' }
  # Write no .pyc for the whole release: the interpreter running a smoke test and the compiler doing
  # import analysis both byte-compile, and a .pyc landing in the runtime directory being packaged
  # reads to the source-leak scan as business source: a false failure nobody can explain.
  $env:PYTHONDONTWRITEBYTECODE = '1'

  # Every toolchain cache defaults to %LOCALAPPDATA%, which is the system drive. The build directory
  # runs happily on the data drive while the system drive slowly fills with uv / Nuitka / zig /
  # ccache / pnpm / Electron caches, until one round's disk gate stops the release outright. That has really
  # happened. Caches must survive across rounds (that is what they are for), so they go *beside* the
  # build input root, not inside the build directory that gets deleted.
  #
  # Each one is set only if unset: build_env was applied above, and what it names wins.
  #
  # Hardlinks: uv's cache must share a volume with the venv it installs into, and pnpm's store must
  # share one with node_modules, or both degrade into full copies. A cache root on the same drive as
  # the source satisfies that by itself.
  if ($CacheRoot) {
    $cacheDirs = @{
      'UV_CACHE_DIR'          = 'uv'
      'UV_PYTHON_INSTALL_DIR' = 'uv-python'
      'NUITKA_CACHE_DIR'      = 'nuitka'
      # Nuitka compiles through zig here, and zig keeps its own compilation cache. Left alone it
      # grows to gigabytes under %LOCALAPPDATA% while everything else is on the data drive.
      'ZIG_GLOBAL_CACHE_DIR'  = 'zig'
      'ZIG_LOCAL_CACHE_DIR'   = 'zig'
      # Nuitka points ccache at its own cache only when CCACHE_DIR is unset. Set it explicitly
      # rather than lean on that fallback.
      'CCACHE_DIR'            = 'ccache'
      # The zip the electron npm package downloads in postinstall. It reads the bare environment
      # variable; putting it in .npmrc does nothing.
      'electron_config_cache' = 'electron'
      # electron-builder's toolchain cache (winCodeSign / nsis / ...). It *must* be an absolute
      # path: a relative one is silently ignored and falls back to the default, with no error.
      'ELECTRON_BUILDER_CACHE' = 'electron-builder'
      # pnpm takes the store's *parent* directory and appends its own v3/v10 version subdirectory.
      # The variable name moves with the version: 10 and below read npm_config_*, 11 and up read
      # pnpm_config_*. Set both; each version ignores the one it does not know.
      'npm_config_store_dir'  = 'pnpm-store'
      'pnpm_config_store_dir' = 'pnpm-store'
    }
    foreach ($name in $cacheDirs.Keys) {
      if ([Environment]::GetEnvironmentVariable($name)) { continue }
      $dir = Join-Path $CacheRoot $cacheDirs[$name]
      try {
        New-Item -ItemType Directory -Force -Path $dir | Out-Null
        [Environment]::SetEnvironmentVariable($name, $dir)
      } catch { Write-Host ("  cache dir skip: " + $name + " (" + $_.Exception.Message + ")") }
    }
    Write-Host ("  toolchain caches: " + $CacheRoot)
  }

  # Put the build's TEMP inside the repo directory: it stays off the system drive, it is deleted
  # with the build directory, and it goes into the antivirus exclusions with everything else.
  $buildTemp = Join-Path $RepoRoot 'runtime\.build-temp'
  try {
    New-Item -ItemType Directory -Force -Path $buildTemp | Out-Null
    $env:TEMP = $buildTemp
    $env:TMP = $buildTemp
  } catch { Write-Host ("  build temp skip: " + $_.Exception.Message) }

  # How the onefile payload gets into the exe. Under zig, Nuitka's default writes a ~300-byte C file
  # that pulls the whole payload in with C23 #embed -- and no compiler cache hashes an #embed'd
  # file. That C text is byte-identical for every target, every product and every round, so zig's
  # cache (and ccache) hand the second compile the first one's object: the exe ships another
  # program's payload while the build log stays green. Measured on this machine: two targets in one
  # round produced byte-identical exes carrying the same payload.
  # 'coff_obj' has Nuitka write that object itself, in Python. The payload never reaches a compiler,
  # so no compiler cache can be blind to it.
  if (-not $env:NUITKA_RESOURCE_MODE) { $env:NUITKA_RESOURCE_MODE = 'coff_obj' }
  Write-Host ("  onefile payload: " + $env:NUITKA_RESOURCE_MODE)

  # Nuitka does not look for ccache on PATH; it has to be pointed at it. Without it every compile
  # starts from scratch.
  if (-not $env:NUITKA_CCACHE_BINARY) {
    $ccache = (Get-Command ccache -ErrorAction SilentlyContinue)
    if ($ccache) { $env:NUITKA_CCACHE_BINARY = $ccache.Source }
  }
  if ($env:NUITKA_CCACHE_BINARY) {
    Write-Host ("  ccache: " + $env:NUITKA_CCACHE_BINARY)
  } else {
    Write-Host "  ccache: not found (every compile will start from scratch)"
  }

  # Real-time scanning inspects every intermediate file the compiler writes, multiplying compile
  # time. Add exclusions, and remove exactly those again at teardown.
  # Exclude where the caches *actually* are: they were just redirected above, so excluding
  # %LOCALAPPDATA% would exclude an empty directory.
  $paths = @($RepoRoot, $buildTemp)
  if ($env:NUITKA_CCACHE_BINARY) { $paths += (Split-Path -Parent $env:NUITKA_CCACHE_BINARY) }
  if ($CacheRoot) { $paths += $CacheRoot }
  foreach ($name in @('UV_CACHE_DIR', 'NUITKA_CACHE_DIR', 'CCACHE_DIR', 'ZIG_GLOBAL_CACHE_DIR', 'npm_config_store_dir')) {
    $value = [Environment]::GetEnvironmentVariable($name)
    if ($value) { $paths += $value }
  }
  $Script:DefenderExclusions = @($paths | Where-Object { $_ } | Select-Object -Unique)
  foreach ($path in $Script:DefenderExclusions) { Set-DefenderExclusion 'Add' $path }
}

# If it cannot be added (no administrator, no Defender, not Windows) log one line and let the build
# run: this is a speed question, not a correctness one.
function Set-DefenderExclusion {
  param([string]$Action, [string]$Path)
  try {
    & "$Action-MpPreference" -ExclusionPath $Path -ErrorAction Stop
    Write-Host ("  defender " + $Action.ToLower() + ": " + $Path)
  } catch {
    Write-Host ("  defender " + $Action.ToLower() + " skip: " + $Path)
  }
}

function Reset-BuildMachine {
  foreach ($path in $Script:DefenderExclusions) { Set-DefenderExclusion 'Remove' $path }
  $Script:DefenderExclusions = @()
}

${RENDERED_HOOK_FUNCTIONS}

# Absolutize the context path: hooks run under $RepoRoot, and a relative path stops resolving the
# moment cwd changes. The remote harness already passes -ReleaseContextPath as an absolute path, and
# this is idempotent for one.
$ReleaseContextPath = (Resolve-Path -LiteralPath $ReleaseContextPath).Path
$Context = Get-Content -Raw -Encoding UTF8 $ReleaseContextPath | ConvertFrom-Json
$RepoRoot = [string]$Context.repo_root
${ELECTRON_SETUP}

# The generic preparation is done above. The key's build_machine.setup only adds what belongs to
# this product: offline wheels, its own cache directories, its own preflight. Each KEY=VALUE line on
# its stdout is applied to this process's environment, which every later step inherits.
# teardown runs in finally, best-effort, and never changes the build verdict.
$BuildMachine = if ($Context.PSObject.Properties.Match('build_machine').Count -gt 0) { $Context.build_machine } else { $null }
$BuildEnv = if ($Context.PSObject.Properties.Match('build_env').Count -gt 0) { $Context.build_env } else { $null }
$CacheRoot = if ($Context.PSObject.Properties.Match('cache_root').Count -gt 0) { [string]$Context.cache_root } else { '' }
try {
  Step "[0/${STEP_TOTAL}] Prepare build machine"
  Initialize-BuildMachine -RepoRoot $RepoRoot -BuildEnv $BuildEnv -CacheRoot $CacheRoot

  if ($BuildMachine -and $BuildMachine.setup) {
    Push-Location $RepoRoot
    try {
      $envLines = & $BuildMachine.setup[0] @($BuildMachine.setup[1..($BuildMachine.setup.Count - 1)])
    } finally { Pop-Location }
    if ($LASTEXITCODE -ne 0) { throw "build machine setup failed ($LASTEXITCODE)" }
    foreach ($line in @($envLines)) {
      if ("$line" -match '^([A-Za-z_][A-Za-z0-9_]*)=(.*)$') {
        [Environment]::SetEnvironmentVariable($Matches[1], $Matches[2])
        Write-Host ("  build env: " + $Matches[1])
      }
    }
  }

${PIPELINE}
}
finally {
  Reset-BuildMachine
  if ($BuildMachine -and $BuildMachine.teardown) {
    Push-Location $RepoRoot
    try { & $BuildMachine.teardown[0] @($BuildMachine.teardown[1..($BuildMachine.teardown.Count - 1)]) | Out-Null } catch { } finally { Pop-Location }
  }
}
