{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${MMW_HOOKS_ROOT}/mmw-activate.js\"",
            "timeout": 5,
            "statusMessage": "Loading MMW discipline..."
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${MMW_HOOKS_ROOT}/mmw-subagent.js\"",
            "timeout": 5,
            "statusMessage": "Loading MMW discipline..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${MMW_HOOKS_ROOT}/mmw-stop.mjs\"",
            "timeout": 10,
            "statusMessage": "Checking ticket gates..."
          }
        ]
      }
    ]
  }
}
