{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "loop-state",
  "description": "内层 loop 的状态 ledger,独立于外层 task.json(并列执行档,旧 plugin 双文件模型的思路)。落 <worktree>/.claude/multi-model-workflow/loop-state.json。进一个 loop 时 init,handoff 结论落定时由 loop close 清(否则残留会污染下阶段 where)。看守 hook、exit-check、以及 flow.sh where(报 inner_loop 断点恢复)都读它。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "attendance", "steps", "checklist", "findings", "decisions", "pause"],
  "properties": {
    "schema_version": { "const": "1" },
    "kind": {
      "enum": ["execution", "review", "contract-gate"],
      "description": "execution=落地 loop(steps);review=审核 loop(checklist+findings);contract-gate=③便宜合同门(steps+checklist 机器核,无判断)"
    },
    "attendance": { "enum": ["attended", "afk"], "description": "在场开关,只动软停一档" },
    "steps": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "desc", "status"],
        "properties": {
          "id": { "type": "string" },
          "desc": { "type": "string" },
          "status": { "enum": ["pending", "done"] },
          "commit": { "type": ["string", "null"] },
          "plan": { "type": ["string", "null"], "description": "该步对应的 plan 文档路径(模式B 一 plan 一步);断点恢复靠它重建步→plan" },
          "worktree": { "type": ["string", "null"], "description": "该 plan 派 Codex 的子 worktree 路径。pending+有 worktree = 已派(去那 worktree 读 codex-session verify/resume);pending+无 worktree = 未派。session 存该 worktree 内 codex-session(一 plan 一 worktree,不共享、无竞争)" }
        }
      },
      "description": "落地=pack/plan;contract-gate=待提交的 pack。主线程展开(steps expand),commit hook 记 done。plan/worktree 支撑模式B 并行 Codex 的内层断点恢复"
    },
    "checklist": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["item", "source", "status"],
        "properties": {
          "item": { "type": "string" },
          "source": { "type": "string", "description": "从哪份文档/行抽出" },
          "status": { "enum": ["open", "covered"] },
          "evidence": { "type": ["string", "null"] }
        }
      },
      "description": "审核 loop 的覆盖清单(主线程从设计/issue 抽);contract-gate 的合同清单"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["severity", "confidence", "locator"],
        "properties": {
          "severity": { "enum": ["Critical", "Important", "Minor"] },
          "confidence": { "type": "integer", "minimum": 1, "maximum": 10 },
          "locator": { "type": "string" },
          "status": { "enum": ["open", "resolved"] }
        }
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["at_step", "chose", "why", "at"],
        "properties": {
          "at_step": { "type": "string" },
          "chose": { "type": "string" },
          "why": { "type": "string" },
          "at": { "type": "string" }
        }
      },
      "description": "无人值守软停自决留痕,不偷跳"
    },
    "pause": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["at_step", "kind", "question"],
      "properties": {
        "at_step": { "type": "string" },
        "kind": { "enum": ["soft", "surface"], "description": "soft=有默认的判断(在场停);surface=缺输入/方向疑(永远停)" },
        "reason": { "enum": ["needs-context", "needs-redirection", "soft"] },
        "question": { "type": "string" }
      },
      "description": "停了写这里,resume 清空。非 null = 等人答复"
    }
  }
}
