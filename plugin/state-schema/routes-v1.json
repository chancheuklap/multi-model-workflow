{
  "schema_version": "1",
  "description": "声明式 route 流程形态清单。把'有哪些 phase、允许怎么跳、budget 初始档、verdict 机械路由'从 state.sh/hook 的硬编码与 SKILL.md 散文抽成单一数据源。state.sh 与 hook 在运行时 jq 读取。work-item 状态机（route 无关）放 global_transitions；phase 推进（route 相关）放 routes[r].phase_transitions；workflow-level verdict 的机械跳转放 verdict_routing（判断类分支留 SKILL.md 散文）。gate 豁免语义由 phases 数组本身编码（route 的 phases 不含某 phase 即豁免），无独立字段。",
  "global_transitions": [
    "Coordinator:pending:dispatched",
    "Coordinator:pending:in_progress",
    "Coordinator:dispatched:returned",
    "Coordinator:returned:committed",
    "Coordinator:returned:review_pending",
    "Coordinator:review_pending:pass",
    "Coordinator:review_pending:needs_repair",
    "Coordinator:returned:repairing",
    "Coordinator:repairing:returned",
    "Coordinator:workflow:dispatched",
    "Coordinator:*:blocked",
    "Coordinator:*:execution_done",
    "Coordinator:*:closed"
  ],
  "routes": {
    "formal": {
      "phases": ["discovery", "plan-writing", "execution", "final-review"],
      "phase_transitions": [
        "Coordinator:workflow:discovery",
        "Coordinator:workflow:plan-writing",
        "Coordinator:workflow:execution",
        "Coordinator:workflow:final-review",
        "Coordinator:discovery:plan-writing",
        "Coordinator:plan-writing:execution",
        "Coordinator:execution:final-review",
        "Coordinator:final-review:closed"
      ],
      "dispatch_shape": { "execution": "plan-level" },
      "budget": { "init": "pending_plan_count" },
      "commit_format": null,
      "review_required": ["baseline"],
      "repair_policy": {
        "execution":    { "max_repair_rounds": 2, "escalate_to_rca": true },
        "final-review": { "max_repair_rounds": 1, "escalate_to_rca": true },
        "plan-review":  { "max_repair_rounds": 2, "escalate_to_rca": false }
      }
    },
    "light": {
      "phases": ["plan-writing", "execution", "final-review"],
      "phase_transitions": [
        "Coordinator:workflow:plan-writing",
        "Coordinator:workflow:execution",
        "Coordinator:workflow:final-review",
        "Coordinator:plan-writing:execution",
        "Coordinator:execution:final-review",
        "Coordinator:final-review:closed"
      ],
      "dispatch_shape": { "execution": "plan-level" },
      "budget": { "init": "unlimited" },
      "commit_format": null,
      "review_required": ["baseline"],
      "repair_policy": {
        "execution":    { "max_repair_rounds": 2, "escalate_to_rca": true },
        "final-review": { "max_repair_rounds": 1, "escalate_to_rca": true },
        "plan-review":  { "max_repair_rounds": 2, "escalate_to_rca": false }
      }
    },
    "direct-repair": {
      "phases": ["direct-repair"],
      "phase_transitions": [],
      "dispatch_shape": { "direct-repair": "route-worker" },
      "budget": { "init": "unlimited" },
      "commit_format": null,
      "review_required": []
    },
    "bug-investigation": {
      "phases": ["bug-investigation"],
      "phase_transitions": [],
      "dispatch_shape": { "bug-investigation": "route-worker" },
      "budget": { "init": "unlimited" },
      "commit_format": null,
      "review_required": []
    },
    "multi-pr-merge": {
      "phases": ["multi-pr-merge"],
      "phase_transitions": [],
      "dispatch_shape": { "multi-pr-merge": "route-worker" },
      "budget": { "init": "unlimited" },
      "commit_format": null,
      "review_required": []
    }
  }
}
