{
  "schema_version": "1",
  "product": "duck",
  "build_target": {
    "desktop_dir": "desktop-fixture",
    "runtime_lane": "embedded_python",
    "entry_module": "fixture.missing",
    "installer_brand": "Fixture",
    "deps_extra": "not_a_real_extra",
    "asset_roots": [],
    "native_ext_dll": [
      {
        "reason": "fixture",
        "dll_names": [
          "missing.dll"
        ],
        "dll_source": "repo",
        "dest": "dist_root"
      }
    ],
    "nuitka_include": [],
    "nuitka_nofollow": []
  },
  "stages": [
    {
      "name": "doctor",
      "run": [
        "true"
      ]
    },
    {
      "name": "compile",
      "run": [
        "true"
      ]
    }
  ],
  "diagnose": [
    "sh",
    "-c",
    "echo '{\"findings\":[]}'"
  ],
  "derive": [
    "true"
  ],
  "editable_paths": [
    "scripts/release/**"
  ],
  "protection_source": "release_protection.json",
  "build_hooks": {
    "runtime_prepare": [
      "true"
    ],
    "artifact_scan": [
      "true"
    ],
    "package_integrity": [
      "true"
    ],
    "asset_parity": null,
    "credential_proof": null
  },
  "post_fix_gate": [
    "true"
  ],
  "fix_executor": [
    "true"
  ],
  "event_sink": [
    "sh",
    "-c",
    "cat >> events.jsonl"
  ]
}
