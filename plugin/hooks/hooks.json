{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/session-start.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/guard-premature-push.sh\""
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "pack-executor",
        "hooks": [
          {
            "type": "command",
            "command": "echo '[multi-model-workflow] pack-executor completed. Next: dispatch workflow-auditor for pack review.' >&2; exit 0"
          }
        ]
      }
    ]
  }
}
