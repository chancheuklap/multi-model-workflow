#!/bin/sh
engine=${MMW_REPO_CHECKS_ENGINE:-"$HOME/.agents/skills/repo-checks/scripts/check.mjs"}
if ! command -v node >/dev/null 2>&1; then echo "repo-checks Node.js unavailable" >&2; [ -n "${MMW_REPO_CHECKS_HOOK:-}" ] && exit 0; exit 70; fi
# Node returns 1 for both module load errors and a failed repository check.
load_engine='const { pathToFileURL } = require("node:url");
import(pathToFileURL(process.argv[1]).href).catch(error => {
  console.error(error);
  process.exitCode = 70;
});'
if [ -f "$engine" ] && [ -z "${MMW_REPO_CHECKS_HOOK:-}" ]; then
  exec node -e "$load_engine" -- "$engine" "$@"
fi
exec node --input-type=module -e '
import { appendFileSync, existsSync, mkdirSync } from "node:fs";
import { execFileSync, spawn } from "node:child_process";
import { createHash } from "node:crypto";
import { join, resolve } from "node:path";
import { constants } from "node:os";

for (const stream of [process.stdout, process.stderr]) stream.on("error", error => {
  if (error.code !== "EPIPE") throw error;
});
const [loadEngine, engine, ...args] = process.argv.slice(1);
const hook = process.env.MMW_REPO_CHECKS_HOOK;
const missing = !existsSync(engine);
function audit(record) {
  const git = (...args) => execFileSync("git", args, { encoding: "utf8" }).trim();
  const common = resolve(git("rev-parse", "--git-common-dir"));
  const key = createHash("sha256").update(git("rev-parse", "--show-toplevel")).digest("hex").slice(0, 24);
  const folder = join(common, "repo-checks", key);
  mkdirSync(folder, { recursive: true });
  appendFileSync(join(folder, "audit.jsonl"), `${JSON.stringify({
    ...record, time: new Date().toISOString(),
  })}\n`);
}
function finish(code, signal = null) {
  const exit = code ?? 128 + constants.signals[signal];
  if (hook && ![0, 1, 2].includes(exit)) {
    const reason = missing ? `engine missing: ${engine}` : `engine failed (${signal ?? exit})`;
    console.error(`repo-checks ${reason}; allowing ${hook}`);
    try {
      audit({ type: "engine-failure", reason, hook, exit_code: exit });
    } catch (error) { console.error(`repo-checks cannot record engine failure: ${error.message}`); }
  }
  process.exitCode = hook ? ([1, 2].includes(exit) ? exit : 0) : exit;
}
const request = args.filter(arg => arg !== "--json");
const diagnostic = ["report", "selftest", "replay"].includes(request[0])
  || (args.length === 1 && args[0] === "--help");
if (missing && process.env.MMW_CHECKS_SKIP?.trim() && !diagnostic) {
  const reason = process.env.MMW_CHECKS_SKIP;
  const bypassHook = hook ?? (request[0] === "--staged" ? "pre-commit" : request[0] === "--push" ? "pre-push" : "manual");
  audit({ type: "bypass", reason, hook: bypassHook });
  if (args.includes("--json")) console.log(JSON.stringify({ mode: "bypass", ok: true, exit_code: 0, reason, hook: bypassHook }));
  else console.log(`SKIPPED BY REASON ${reason}`);
  process.exit(0);
}
if (missing) console.error(`repo-checks engine missing: ${engine}`);
if (missing && args[0] !== "--staged") finish(70);
else if (missing && !existsSync("prek.toml") && !existsSync(".pre-commit-config.yaml")) finish(0);
else {
  const child = missing ? spawn("prek", ["run"], { stdio: "inherit" })
    : spawn(process.execPath, ["-e", loadEngine, "--", engine, ...args], { stdio: "inherit" });
  for (const signal of ["SIGINT", "SIGTERM"]) process.on(signal, () => child.kill(signal));
  child.once("error", error => {
    if (missing && error.code === "ENOENT") {
      console.error("Install prek: brew install prek (or uv tool install prek).");
      finish(2);
    } else {
      console.error(`repo-checks ${error.message}`);
      finish(70);
    }
  });
  child.once("exit", (code, signal) => finish(missing && code !== null ? (code === 0 ? 0 : 1) : code, signal));
}
' "$load_engine" "$engine" "$@"
