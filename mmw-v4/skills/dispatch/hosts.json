{
  "defaults": [
    {"agent": "junior-worker", "host": "codex", "model": "gpt 6.1 sol", "effort": "medium"},
    {"agent": "senior-worker", "host": "codex", "model": "gpt 6.1 sol", "effort": "high"},
    {"agent": "reviewer", "host": "claude", "model": "opus[1m]", "effort": "high"},
    {"agent": "advisor", "host": "claude", "model": "fable[1m]", "effort": "medium"},
    {"agent": "researcher", "host": "codex", "model": "gpt 6.1 sol", "effort": "medium"},
    {"agent": "candidate", "host": "claude", "model": "opus[1m]", "effort": "xhigh"}
  ],
  "hosts": {
    "claude": {
      "binary": "claude",
      "efforts": ["low", "medium", "high", "xhigh", "max"],
      "cli": {
        "argv": ["--model", "{model}", "--effort", "{effort}", "--permission-mode", "bypassPermissions", "-n", "{name}"]
      },
      "paseo": {
        "settings": {"modeId": "bypassPermissions"},
        "thinking": "option_id"
      }
    },
    "codex": {
      "binary": "codex",
      "efforts": ["low", "medium", "high", "xhigh"],
      "cli": {
        "argv": ["-m", "{model}", "-c", "model_reasoning_effort=\"{effort}\"", "--dangerously-bypass-approvals-and-sandbox"]
      },
      "paseo": {
        "settings": {"modeId": "full-access"},
        "thinking": "option_id"
      }
    }
  }
}
